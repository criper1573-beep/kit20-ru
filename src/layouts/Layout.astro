---
/**
 * Публичный каркас в дизайне «Программка» (docs/concept/kit20-concept.html).
 * Админка использует отдельный AdminLayout.astro — стили концепта туда не попадают.
 * ВАЖНО: nginx вставляет t.js через sub_filter по первому '</body>' — не печатать эту строку раньше конца документа.
 */
import '../styles/global.css';
import '../styles/programmka.css';
import GameSlot from '../components/GameSlot.astro';

interface Props {
	title: string;
	description?: string;
	/** Прочие страницы (не главная): отступ под фиксированную шапку. */
	bare?: boolean;
}

const {
	title,
	description = 'Набор КИТ-20: учебная группа театра и кино Парт Академии, 2026–2028. Афиша показов, труппа, этюды, явка, касса и дни рождения.',
} = Astro.props;

const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: 'Афиша', match: (p: string) => p === '/' },
	{ href: '/class', label: 'Труппа и этюды', match: (p: string) => p.startsWith('/class') },
	{ href: '/attendance', label: 'Явка', match: (p: string) => p.startsWith('/attendance') },
	{ href: '/obshchak', label: 'Касса', match: (p: string) => p.startsWith('/obshchak') },
	{ href: '/dni-rozhdeniya', label: 'Дни рождения', match: (p: string) => p.startsWith('/dni-rozhdeniya') },
	{ href: '#game', label: 'Игра', match: () => false },
];
const fullTitle = pathname === '/' ? title : `${title} · КиТ20`;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#100d0c" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href="/fonts/AlumniSans-normal-500-900-cyr.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/GolosText-normal-400-700-cyr.woff2" as="font" type="font/woff2" crossorigin />
		<title>{fullTitle}</title>
	</head>
	<body class="no-js prog">
		<a class="skip" href="#main">К содержанию</a>

		<header class="bar" id="bar">
			<a class="logo" href="/" aria-label="КиТ20, на главную">КиТ<b>20</b></a>
			<button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Программка</button>
			<nav id="nav" aria-label="Разделы">
				<ul>
					{
						links.map(({ href, label, match }) => (
							<li>
								<a href={href} aria-current={match(pathname) ? 'page' : undefined}>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<a class="btn btn--red" href="https://t.me/VAZHEVA_AA" target="_blank" rel="noopener">Написать старосте</a>
		</header>

		<main id="main">
			<slot />
		</main>

		<!-- ПОКЛОН -->
		<section class="bow" aria-labelledby="bow-h">
			<div class="wrap">
				<h2 id="bow-h">Поклон</h2>
				<p>Вопросы, идеи, взносы и «а когда показ?» — всё к старосте.</p>
				<div class="ctas">
					<a class="btn btn--red" href="https://t.me/VAZHEVA_AA" target="_blank" rel="noopener">Написать старосте в Telegram</a>
					<a class="btn btn--ghost" href="#game">Антракт: игра</a>
				</div>
			</div>
		</section>

		<GameSlot />

		<footer class="foot">
			<div class="wrap">
				<span>КиТ20 · учебная группа театра и кино · Парт Академия · 2026–2028</span>
				<span><a href="/">kit20.ru</a> · <a href="/admin">Вход для администратора</a></span>
			</div>
		</footer>

		<script is:inline>
			(function () {
				document.body.classList.remove('no-js');
				var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
				// меню
				var bar = document.getElementById('bar');
				var mb = bar && bar.querySelector('.menu-btn');
				if (bar && mb) {
					mb.addEventListener('click', function () {
						var o = bar.classList.toggle('is-menu');
						mb.setAttribute('aria-expanded', String(o));
					});
					bar.querySelectorAll('nav a').forEach(function (a) {
						a.addEventListener('click', function () {
							bar.classList.remove('is-menu');
							mb.setAttribute('aria-expanded', 'false');
						});
					});
					document.addEventListener('keydown', function (e) {
						if (e.key === 'Escape' && bar.classList.contains('is-menu')) {
							bar.classList.remove('is-menu');
							mb.setAttribute('aria-expanded', 'false');
						}
					});
				}
				// появления
				if ('IntersectionObserver' in window && !reduce) {
					var io = new IntersectionObserver(function (es) {
						es.forEach(function (e) {
							if (e.isIntersecting) {
								e.target.classList.add('is-in');
								io.unobserve(e.target);
							}
						});
					}, { rootMargin: '0px 0px -10% 0px' });
					document.querySelectorAll('.reveal, .hall').forEach(function (el) { io.observe(el); });
				} else {
					document.querySelectorAll('.reveal, .hall').forEach(function (el) { el.classList.add('is-in'); });
				}
				document.querySelectorAll('.seat').forEach(function (s, i) { s.style.setProperty('--i', String(i)); });
			})();
		</script>

		<!-- Yandex.Metrika counter -->
		<script is:inline>
			(function (m, e, t, r, i, k, a) {
				m[i] =
					m[i] ||
					function () {
						(m[i].a = m[i].a || []).push(arguments);
					};
				m[i].l = 1 * new Date();
				for (var j = 0; j < document.scripts.length; j++) {
					if (document.scripts[j].src === r) {
						return;
					}
				}
				k = e.createElement(t);
				a = e.getElementsByTagName(t)[0];
				k.async = 1;
				k.src = r;
				a.parentNode.insertBefore(k, a);
			})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=108705431', 'ym');
			ym(108705431, 'init', {
				ssr: true,
				webvisor: true,
				clickmap: true,
				ecommerce: 'dataLayer',
				referrer: document.referrer,
				url: location.href,
				accurateTrackBounce: true,
				trackLinks: true,
			});
		</script>
		<noscript>
			<div>
				<img src="https://mc.yandex.ru/watch/108705431" style="position:absolute; left:-9999px;" alt="" />
			</div>
		</noscript>
		<!-- /Yandex.Metrika counter -->
	</body>
</html>
