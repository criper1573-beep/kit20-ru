---
import StudentAvatar from './StudentAvatar.astro';
import type { StudentFrontmatter } from '../lib/schemas';

interface Row {
	slug: string;
	data: StudentFrontmatter;
	variant: number;
}

interface Props {
	students: Row[];
}

const { students } = Astro.props;
---

{
	students.map(({ slug, data, variant }) => (
		<dialog
			id={`dlg-${slug}`}
			class="fixed left-1/2 top-1/2 z-[100] w-[min(100vw-2rem,28rem)] max-w-[calc(100vw-2rem)] -translate-x-1/2 -translate-y-1/2 overflow-hidden border-[3px] border-ink bg-surface p-0 text-ink shadow-[var(--shadow-float)]"
		>
			<div class="border-b-[3px] border-ink bg-muted-surface px-5 py-4">
				<div class="flex items-start justify-between gap-4">
					<div>
						<h2 class="font-display text-2xl font-normal uppercase tracking-wider text-ink sm:text-3xl">
							{data.displayName}
						</h2>
						{data.fullName && <p class="font-sans text-sm uppercase text-muted">{data.fullName}</p>}
					</div>
					<button
						type="button"
						class="type-cta border-[3px] border-ink bg-surface px-3 py-2 text-sm text-ink shadow-[var(--shadow-card)] transition-colors hover:bg-accent hover:text-canvas active-shift"
						data-close-dialog=""
					>
						Закрыть
					</button>
				</div>
			</div>
			<div class="max-h-[min(70vh,32rem)] overflow-y-auto px-5 py-6">
				<div class="mb-2 flex gap-5">
					<div class="h-28 w-24 shrink-0 overflow-hidden border-[3px] border-ink bg-muted-surface">
						{data.photo ? (
							<img
								src={data.photo}
								alt={`Фото: ${data.displayName}`}
								class="h-full w-full object-cover object-top"
								loading="lazy"
							/>
						) : (
							<StudentAvatar variant={variant} displayName={data.displayName} class="h-full w-full" />
						)}
					</div>
					<dl class="grid flex-1 gap-2 font-sans text-sm">
						{data.fullName && (
							<div class="flex justify-between gap-4 border-b-2 border-ink/10 py-1.5">
								<dt class="font-bold text-muted">ФИО</dt>
								<dd class="text-right font-bold text-ink">{data.fullName}</dd>
							</div>
						)}
						{data.displayName && (
							<div class="flex justify-between gap-4 border-b-2 border-ink/10 py-1.5">
								<dt class="font-bold text-muted">Имя</dt>
								<dd class="text-right font-bold text-ink">{data.displayName}</dd>
							</div>
						)}
						{data.nickname && (
							<div class="flex justify-between gap-4 border-b-2 border-ink/10 py-1.5">
								<dt class="font-bold text-muted">НИК</dt>
								<dd class="text-right font-bold text-ink">{data.nickname}</dd>
							</div>
						)}
						{data.birthday && (
							<div class="flex justify-between gap-4 border-b-2 border-ink/10 py-1.5">
								<dt class="font-bold text-muted">ДР</dt>
								<dd class="text-right font-bold text-ink">{data.birthday}</dd>
							</div>
						)}
						{data.phone && (
							<div class="flex justify-between gap-4 border-b-2 border-ink/10 py-1.5">
								<dt class="font-bold text-muted">ТЕЛ</dt>
								<dd class="text-right font-bold text-ink">{data.phone}</dd>
							</div>
						)}
					</dl>
				</div>
			</div>
		</dialog>
	))
}

<script is:inline>
	(function () {
		function closeAll() {
			document.querySelectorAll('dialog[id^="dlg-"]').forEach(function (dlg) {
				if (dlg instanceof HTMLDialogElement && dlg.open) dlg.close();
			});
		}

		function openBySlug(slug) {
			if (!slug) return;
			const dlg = document.getElementById('dlg-' + slug);
			if (!(dlg instanceof HTMLDialogElement)) return;
			if (dlg.open) return;
			closeAll();
			dlg.showModal();
		}

		const isTouchUi = window.matchMedia('(hover: none), (pointer: coarse)').matches;
		let hoverTimer = 0;

		document.addEventListener('mouseover', function (e) {
			if (isTouchUi) return;
			const t = e.target;
			const btn = t instanceof Element ? t.closest('[data-open-profile]') : null;
			if (!btn) return;
			window.clearTimeout(hoverTimer);
			hoverTimer = window.setTimeout(function () {
				openBySlug(btn.getAttribute('data-open-profile'));
			}, 140);
		});

		document.addEventListener('mouseout', function (e) {
			if (isTouchUi) return;
			const t = e.target;
			const btn = t instanceof Element ? t.closest('[data-open-profile]') : null;
			if (!btn) return;
			window.clearTimeout(hoverTimer);
		});

		document.addEventListener('click', function (e) {
			const t = e.target;
			if (!(t instanceof Element)) return;
			const closeBtn = t.closest('[data-close-dialog]');
			if (closeBtn) {
				const dlg = closeBtn.closest('dialog');
				if (dlg instanceof HTMLDialogElement) dlg.close();
				return;
			}
			const openBtn = t.closest('[data-open-profile]');
			if (openBtn) {
				e.preventDefault();
				openBySlug(openBtn.getAttribute('data-open-profile'));
			}
		});

		document.querySelectorAll('dialog[id^="dlg-"]').forEach(function (dlg) {
			dlg.addEventListener('click', function (e) {
				if (e.target === dlg && dlg instanceof HTMLDialogElement) dlg.close();
			});
		});
	})();
</script>
