---
import type { Spectacle } from '../lib/schemas';
import { sortSpectacles } from '../lib/spectacles';
interface Props {
	spectacles: Spectacle[];
}
const { spectacles } = Astro.props;
const items = sortSpectacles(spectacles).filter((s) => s.id);
/** Длина самого длинного слова — для CSS-подгонки кегля (слово не должно рваться). */
function longestWordChars(text: string): number {
	return Math.max(1, ...text.split(/\s+/).map((w) => Array.from(w).length));
}
function regaliaSizeClass(text: string): string {
	const n = Array.from(text.trim()).length;
	if (n > 480) return 'spectacle-regalia spectacle-regalia--xlong';
	if (n > 200) return 'spectacle-regalia spectacle-regalia--long';
	return 'spectacle-regalia';
}
---
{
	items.length > 0 && (
		<section class="specs" aria-label="Спектакли">
			{items.map((spec, spectacleIndex) => {
				const gallery = spec.gallery.filter((url) => url.trim());
				const hasDirPhoto = Boolean(spec.directorPhoto?.trim());
				return (
					<article class="spec reveal" data-spectacle-id={spec.id}>
						<div class="spec__main">
							<figure class="spec__poster" style={`--r:${spectacleIndex % 2 ? '1.2deg' : '-1.5deg'}`}>
								{spec.heroPhoto ? (
									<img
										src={spec.heroPhoto}
										alt={`Афиша: ${spec.title || 'спектакль'}`}
										loading={spectacleIndex === 0 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								) : (
									<div class="spec__noposter">
										<span>Афиша</span>
										<small>появится позже</small>
									</div>
								)}
							</figure>
							<div class="spec__info">
								<p class="overline">Спектакль · <b>{String(spectacleIndex + 1).padStart(2, '0')}</b></p>
								<h3 class="spec__title">{spec.title || 'Название уточняется'}</h3>
								<dl class="facts">
									<dt>Режиссёр</dt>
									<dd>{spec.directorName || <span class="muted">уточняется</span>}</dd>
									<dt>Дата</dt>
									<dd class="muted">уточняется</dd>
								</dl>
								{(spec.directorName || spec.directorRegalia.trim()) && (
									<div class:list={['spectacle-pair spectacle-pair--director', { 'spectacle-pair--nophoto': !hasDirPhoto }]}>
										<div class="spectacle-caption" data-fit-caption>
											<p class="spectacle-kicker">Режиссёр</p>
											<h4
												class="spectacle-title spectacle-title--dir"
												data-fit-title
												style={`--fit-chars: ${longestWordChars(spec.directorName || '—')}`}
											>
												{spec.directorName || '—'}
											</h4>
											{spec.directorRegalia.trim() && (
												<div class="spectacle-regalia-wrap" data-regalia-wrap>
													<p class={regaliaSizeClass(spec.directorRegalia)} data-regalia>
														{spec.directorRegalia}
													</p>
													<button type="button" class="spectacle-more" data-regalia-toggle aria-expanded="false" hidden>
														Подробнее
													</button>
												</div>
											)}
										</div>
										{hasDirPhoto && (
											<figure class="spectacle-frame">
												<img
													src={spec.directorPhoto}
													alt={spec.directorName || 'Режиссёр'}
													class="spectacle-photo"
													loading="lazy"
													decoding="async"
												/>
											</figure>
										)}
									</div>
								)}
							</div>
						</div>
						{gallery.length > 0 && (
							<div class="spectacle-coverflow-wrap" data-spectacle-coverflow>
								<p class="spectacle-kicker">Кадры · {gallery.length}</p>
								<div class="spectacle-coverflow" data-coverflow-root>
									<button
										type="button"
										class="spectacle-coverflow-nav spectacle-coverflow-nav--prev"
										data-coverflow-prev
										aria-label="Предыдущий кадр"
									>
										‹
									</button>
									<div class="spectacle-coverflow-stage" data-coverflow-stage>
										{gallery.map((url, i) => (
											<button
												type="button"
												class="spectacle-coverflow-item"
												data-coverflow-item
												data-lightbox-src={url}
												data-index={i}
												aria-label={`Открыть кадр ${i + 1} спектакля ${spec.title || ''}`}
											>
												<img
													data-src={url}
													data-coverflow-photo
													alt=""
													class="spectacle-coverflow-photo"
													loading="lazy"
													decoding="async"
													draggable="false"
												/>
											</button>
										))}
									</div>
									<button
										type="button"
										class="spectacle-coverflow-nav spectacle-coverflow-nav--next"
										data-coverflow-next
										aria-label="Следующий кадр"
									>
										›
									</button>
								</div>
								<div class="spectacle-coverflow-dots" data-coverflow-dots role="tablist" aria-label="Кадры галереи">
									{gallery.map((_, i) => (
										<button
											type="button"
											class="spectacle-coverflow-dot"
											data-coverflow-dot
											data-index={i}
											aria-label={`Кадр ${i + 1}`}
										/>
									))}
								</div>
							</div>
						)}
					</article>
				);
			})}
			<dialog id="spectacle-lightbox" class="spectacle-lightbox" aria-label="Просмотр кадра">
				<button type="button" class="spectacle-lightbox-close" data-lightbox-close aria-label="Закрыть">
					Закрыть
				</button>
				<button type="button" class="spectacle-lightbox-nav spectacle-lightbox-nav--prev" data-lightbox-prev aria-label="Предыдущий кадр">
					‹
				</button>
				<img id="spectacle-lightbox-img" class="spectacle-lightbox-img" alt="" loading="eager" decoding="async" />
				<button type="button" class="spectacle-lightbox-nav spectacle-lightbox-nav--next" data-lightbox-next aria-label="Следующий кадр">
					›
				</button>
			</dialog>
		</section>
	)
}
<style>
	/* «Программка»: афиши как в концепте (повёрнутый постер + факты), подпись режиссёра с прежней подгонкой кегля. */
	.specs {
		display: grid;
		gap: clamp(56px, 8vw, 110px);
	}
	.spec__main {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: start;
	}
	.spec:nth-child(even) .spec__main {
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
	}
	.spec:nth-child(even) .spec__poster {
		order: 2;
	}
	.spec__poster {
		position: relative;
		max-width: 520px;
		margin: 0;
		background: var(--ink);
		box-shadow: 0 30px 60px -30px rgba(27, 21, 18, 0.55);
		transform: rotate(var(--r, 0deg));
		transition: transform 0.5s var(--ease-out);
	}
	.spec:hover .spec__poster {
		transform: rotate(0) translateY(-6px);
	}
	.spec__poster img {
		width: 100%;
		height: auto;
	}
	.spec__noposter {
		aspect-ratio: 720 / 1018;
		display: grid;
		place-content: center;
		text-align: center;
		color: var(--on-dark);
		background: radial-gradient(ellipse 70% 55% at 50% 40%, rgba(255, 90, 85, 0.16), transparent 70%), var(--ink);
	}
	.spec__noposter span {
		font: 900 clamp(48px, 6vw, 84px) / 0.85 var(--f-poster);
		text-transform: uppercase;
	}
	.spec__noposter small {
		font: 500 12px/1.4 var(--f-mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--on-dark-2);
		margin-top: 10px;
	}
	.spec__info .overline {
		margin-top: 8px;
	}
	.spec__title {
		font: 900 clamp(44px, 5.6vw, 88px) / 0.85 var(--f-poster);
		text-transform: uppercase;
		margin: 8px 0 16px;
		overflow-wrap: normal;
		word-break: normal;
		hyphens: none;
	}
	.spec .facts {
		margin-bottom: 22px;
	}
	.spectacle-pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
		border-top: 2px solid var(--ink);
	}
	.spectacle-pair--nophoto {
		grid-template-columns: minmax(0, 1fr);
	}
	.spectacle-frame {
		aspect-ratio: 2 / 3;
		min-width: 0;
		margin: 0;
		background: var(--paper-2);
	}
	.spectacle-photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: grayscale(0.2);
	}
	.spectacle-caption {
		display: flex;
		min-width: 0;
		min-height: 0;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.5rem;
		padding: 14px 18px 4px 0;
		overflow: hidden;
		/* Высота подписи = высоте портрета 2:3; даёт единицы cqi для подгонки кегля. */
		container-type: size;
	}
	.spectacle-pair--nophoto > .spectacle-caption {
		container-type: inline-size;
		overflow: visible;
		padding-right: 0;
	}
	.spectacle-pair.is-expanded > .spectacle-caption {
		container-type: inline-size;
		overflow: visible;
	}
	.spectacle-pair.is-expanded > .spectacle-frame {
		align-self: start;
	}
	.spectacle-kicker {
		margin: 0;
		flex: none;
		font: 500 12px/1.4 var(--f-mono);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--red);
	}
	.spectacle-title {
		--fit-chars: 8;
		margin: 0;
		flex: none;
		font-family: var(--f-poster);
		font-weight: 900;
		font-size: clamp(1.4rem, min(calc(190cqi / var(--fit-chars)), 22cqi), 3.2rem);
		line-height: 0.9;
		text-transform: uppercase;
		color: var(--ink);
		overflow-wrap: normal;
		word-break: keep-all;
		hyphens: none;
		-webkit-hyphens: none;
	}
	.spectacle-regalia-wrap {
		display: flex;
		min-height: 0;
		flex: 0 1 auto;
		flex-direction: column;
		gap: 0.4rem;
	}
	.spectacle-regalia {
		margin: 0;
		min-height: 0;
		flex: 0 1 auto;
		max-width: 52ch;
		overflow: hidden;
		font: italic 400 16px/1.45 var(--f-serif);
		color: var(--ink-2);
		overflow-wrap: break-word;
	}
	.spectacle-regalia--long {
		font-size: 15px;
		line-height: 1.4;
	}
	.spectacle-regalia--xlong {
		font-size: 14.5px;
		line-height: 1.38;
	}
	.spectacle-regalia-wrap.is-clamped .spectacle-regalia {
		-webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.6em), transparent);
		mask-image: linear-gradient(to bottom, #000 calc(100% - 2.6em), transparent);
	}
	.spectacle-pair.is-expanded .spectacle-regalia {
		overflow: visible;
		-webkit-mask-image: none;
		mask-image: none;
	}
	.spectacle-more {
		flex: none;
		align-self: flex-start;
		margin: 0;
		padding: 0 0 2px;
		min-height: 32px;
		border: 0;
		border-bottom: 2px solid var(--red);
		background: none;
		font: 600 12px/1 var(--f-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--red);
		cursor: pointer;
	}
	.spectacle-more[hidden] {
		display: none;
	}
	.spectacle-coverflow-wrap {
		min-width: 0;
		margin-top: clamp(28px, 4vw, 48px);
	}
	.spectacle-coverflow-wrap > .spectacle-kicker {
		margin-bottom: 10px;
	}
	.spectacle-coverflow {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--ink);
		padding: 22px 10px;
		border-radius: 4px;
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	/* перфорация киноплёнки */
	.spectacle-coverflow::before,
	.spectacle-coverflow::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		height: 14px;
		background: radial-gradient(ellipse 5px 3.5px at 50% 50%, var(--paper) 0 98%, transparent 100%) 0 50% / 20px 14px repeat-x;
		opacity: 0.18;
		pointer-events: none;
	}
	.spectacle-coverflow::before {
		top: 4px;
	}
	.spectacle-coverflow::after {
		bottom: 4px;
	}
	.spectacle-coverflow-stage {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		height: clamp(12rem, 48vw, 20rem);
		perspective: 900px;
		overflow: hidden;
	}
	.spectacle-coverflow-item {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(34%, 7.5rem);
		aspect-ratio: 2 / 3;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 2px;
		background: var(--stage-2);
		transform: translate(-50%, -50%) scale(0.55);
		opacity: 0;
		pointer-events: none;
		cursor: pointer;
		transition:
			transform 280ms var(--ease-out),
			opacity 280ms ease,
			z-index 0s,
			box-shadow 280ms ease;
		z-index: 0;
		overflow: hidden;
	}
	.spectacle-coverflow-item.is-slot-0 {
		width: min(42%, 9.5rem);
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
		pointer-events: auto;
		z-index: 5;
		box-shadow: 0 18px 36px rgb(0 0 0 / 0.55);
	}
	.spectacle-coverflow-item.is-slot-m1 {
		transform: translate(calc(-50% - 62%), -50%) scale(0.78);
		opacity: 0.7;
		pointer-events: auto;
		z-index: 4;
	}
	.spectacle-coverflow-item.is-slot-p1 {
		transform: translate(calc(-50% + 62%), -50%) scale(0.78);
		opacity: 0.7;
		pointer-events: auto;
		z-index: 4;
	}
	.spectacle-coverflow-item.is-slot-m2 {
		transform: translate(calc(-50% - 108%), -50%) scale(0.62);
		opacity: 0.4;
		pointer-events: auto;
		z-index: 3;
	}
	.spectacle-coverflow-item.is-slot-p2 {
		transform: translate(calc(-50% + 108%), -50%) scale(0.62);
		opacity: 0.4;
		pointer-events: auto;
		z-index: 3;
	}
	.spectacle-coverflow-item:hover,
	.spectacle-coverflow-item:focus-visible {
		outline: 3px solid var(--red-hi);
		outline-offset: -3px;
	}
	.spectacle-coverflow-photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}
	.spectacle-coverflow-nav {
		flex: 0 0 auto;
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--on-dark-2);
		border-radius: 50%;
		background: transparent;
		color: var(--on-dark);
		font: 600 26px/1 var(--f-body);
		cursor: pointer;
		z-index: 6;
		transition: background 0.2s, color 0.2s, border-color 0.2s;
	}
	.spectacle-coverflow-nav:hover,
	.spectacle-coverflow-nav:focus-visible {
		background: var(--red);
		border-color: var(--red);
	}
	.spectacle-coverflow-dots {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px;
		margin-top: 10px;
	}
	.spectacle-coverflow-dot {
		width: 24px;
		height: 24px;
		padding: 0;
		border: 0;
		background: radial-gradient(circle, var(--ink-2) 0 4px, transparent 4.5px);
		cursor: pointer;
	}
	.spectacle-coverflow-dot.is-active {
		background: radial-gradient(circle, var(--red) 0 5px, transparent 5.5px);
	}
	@media (min-width: 640px) {
		.spectacle-coverflow-stage {
			height: clamp(14rem, 30vw, 22rem);
		}
		.spectacle-coverflow-item {
			width: min(26%, 9rem);
		}
		.spectacle-coverflow-item.is-slot-0 {
			width: min(32%, 12rem);
		}
	}
	@media (max-width: 760px) {
		.spec__main,
		.spec:nth-child(even) .spec__main {
			grid-template-columns: 1fr;
		}
		.spec:nth-child(even) .spec__poster {
			order: 0;
		}
		.spec__poster {
			max-width: min(420px, 100%);
			transform: rotate(calc(var(--r, 0deg) * 0.6));
		}
		.spectacle-regalia {
			font-size: 15px;
		}
	}
</style>
<style is:global>
	.spectacle-lightbox {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: rgb(16 13 12 / 0.95);
	}
	.spectacle-lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.spectacle-lightbox::backdrop {
		background: rgb(16 13 12 / 0.9);
	}
	.spectacle-lightbox-img {
		max-width: 92vw;
		max-height: 86vh;
		object-fit: contain;
		box-shadow: 0 40px 80px rgb(0 0 0 / 0.6);
	}
	.spectacle-lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 2;
		min-height: 44px;
		padding: 0 18px;
		border: 0;
		border-radius: 999px;
		background: var(--red, #b8141b);
		font: 600 14px/1 var(--f-body, sans-serif);
		color: #fff;
		cursor: pointer;
	}
	.spectacle-lightbox-nav {
		position: fixed;
		top: 50%;
		z-index: 2;
		width: 48px;
		height: 48px;
		transform: translateY(-50%);
		border: 1.5px solid var(--on-dark-2, #b9ab9c);
		border-radius: 50%;
		background: rgb(16 13 12 / 0.6);
		font: 600 28px/1 var(--f-body, sans-serif);
		color: var(--on-dark, #f4ede0);
		cursor: pointer;
	}
	.spectacle-lightbox-nav:hover {
		background: var(--red, #b8141b);
	}
	.spectacle-lightbox-nav--prev {
		left: 0.75rem;
	}
	.spectacle-lightbox-nav--next {
		right: 0.75rem;
	}
</style>
<script>
	// Подгонка подписей спектаклей: слово не рвётся (кегль уменьшается до ширины),
	// подпись не выше фото (регалии ужимаются, затем обрезаются с «Подробнее»).
	const TITLE_MIN_PX = 11;
	const REGALIA_MIN_PX = 10;
	function fitTitleWidth(el: HTMLElement) {
		el.style.fontSize = '';
		let size = parseFloat(getComputedStyle(el).fontSize) || 16;
		let guard = 80;
		while (guard-- > 0 && size > TITLE_MIN_PX && el.scrollWidth > el.clientWidth + 1) {
			size = Math.max(TITLE_MIN_PX, size * 0.95);
			el.style.fontSize = `${size}px`;
		}
	}
	function fitCaption(caption: HTMLElement) {
		const pair = caption.closest<HTMLElement>('.spectacle-pair');
		const expanded = pair?.classList.contains('is-expanded') ?? false;
		const titles = [...caption.querySelectorAll<HTMLElement>('[data-fit-title]')];
		titles.forEach(fitTitleWidth);
		const wrap = caption.querySelector<HTMLElement>('[data-regalia-wrap]');
		const regalia = wrap?.querySelector<HTMLElement>('[data-regalia]') ?? null;
		const toggle = wrap?.querySelector<HTMLButtonElement>('[data-regalia-toggle]') ?? null;
		if (wrap && regalia && toggle) {
			if (expanded) {
				toggle.hidden = false;
			} else {
				wrap.classList.remove('is-clamped');
				toggle.hidden = true;
				regalia.style.fontSize = '';
				let size = parseFloat(getComputedStyle(regalia).fontSize) || 12;
				let guard = 40;
				while (guard-- > 0 && size > REGALIA_MIN_PX && regalia.scrollHeight > regalia.clientHeight + 1) {
					size = Math.max(REGALIA_MIN_PX, size - 0.5);
					regalia.style.fontSize = `${size}px`;
				}
				if (regalia.scrollHeight > regalia.clientHeight + 1) {
					wrap.classList.add('is-clamped');
					toggle.hidden = false;
				}
			}
		}
		if (!expanded) {
			// Подпись без регалий (например, длинное многословное название) — ужать заголовок по высоте.
			let guard = 60;
			while (guard-- > 0 && caption.scrollHeight > caption.clientHeight + 1) {
				let shrunk = false;
				titles.forEach((t) => {
					const size = parseFloat(getComputedStyle(t).fontSize) || 16;
					if (size > TITLE_MIN_PX) {
						t.style.fontSize = `${Math.max(TITLE_MIN_PX, size * 0.94)}px`;
						shrunk = true;
					}
				});
				if (!shrunk) break;
			}
		}
	}
	function fitAllCaptions() {
		document.querySelectorAll<HTMLElement>('[data-fit-caption]').forEach(fitCaption);
	}
	let fitFrame = 0;
	function scheduleFit() {
		if (fitFrame) cancelAnimationFrame(fitFrame);
		fitFrame = requestAnimationFrame(() => {
			fitFrame = 0;
			fitAllCaptions();
		});
	}
	document.querySelectorAll<HTMLButtonElement>('[data-regalia-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const pair = btn.closest<HTMLElement>('.spectacle-pair');
			if (!pair) return;
			const expanded = pair.classList.toggle('is-expanded');
			btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			btn.textContent = expanded ? 'Свернуть' : 'Подробнее';
			const caption = btn.closest<HTMLElement>('[data-fit-caption]');
			if (caption) fitCaption(caption);
		});
	});
	if ('ResizeObserver' in window) {
		const ro = new ResizeObserver(scheduleFit);
		document.querySelectorAll<HTMLElement>('.spectacle-pair').forEach((el) => ro.observe(el));
	} else {
		window.addEventListener('resize', scheduleFit);
	}
	fitAllCaptions();
	document.fonts?.ready.then(scheduleFit).catch(() => {});
</script>
<script>
	const dialog = document.getElementById('spectacle-lightbox') as HTMLDialogElement | null;
	const img = document.getElementById('spectacle-lightbox-img') as HTMLImageElement | null;
	if (dialog && img) {
		let urls: string[] = [];
		let index = 0;
		function show(at: number) {
			if (!urls.length || !img) return;
			index = (at + urls.length) % urls.length;
			img.loading = 'eager';
			img.src = urls[index] ?? '';
		}
		function openLightbox(list: string[], at: number) {
			urls = list;
			show(at);
			dialog?.showModal();
		}
		function closeLightbox() {
			dialog?.close();
			// Do not retain the full-size image after closing the lightbox.
			img.removeAttribute('src');
			img.alt = '';
			urls = [];
		}
		function wrapIndex(i: number, len: number) {
			return ((i % len) + len) % len;
		}
		function syncCoverflowImages(items: HTMLElement[], center: number) {
			const n = items.length;
			const nearCenter = new Set<number>();
			for (let slot = -2; slot <= 2; slot++) nearCenter.add(wrapIndex(center + slot, n));
			items.forEach((item, i) => {
				const image = item.querySelector<HTMLImageElement>('[data-coverflow-photo]');
				if (!image) return;
				if (nearCenter.has(i)) {
					const src = image.dataset.src;
					if (src && !image.getAttribute('src')) image.src = src;
					image.loading = i === center ? 'eager' : 'lazy';
				} else {
					image.removeAttribute('src');
					image.loading = 'lazy';
				}
			});
		}
		function renderCoverflow(root: HTMLElement, active: number) {
			const items = [...root.querySelectorAll<HTMLElement>('[data-coverflow-item]')];
			const dots = [...root.querySelectorAll<HTMLElement>('[data-coverflow-dot]')];
			const n = items.length;
			if (!n) return;
			const center = wrapIndex(active, n);
			const slotClass = ['is-slot-m2', 'is-slot-m1', 'is-slot-0', 'is-slot-p1', 'is-slot-p2'] as const;
			items.forEach((el) => {
				el.classList.remove(...slotClass);
			});
			for (let slot = -2; slot <= 2; slot++) {
				const idx = wrapIndex(center + slot, n);
				const el = items[idx];
				if (!el) continue;
				const name = slotClass[slot + 2];
				if (name) el.classList.add(name);
			}
			syncCoverflowImages(items, center);
			dots.forEach((dot, i) => {
				dot.classList.toggle('is-active', i === center);
				dot.setAttribute('aria-current', i === center ? 'true' : 'false');
			});
			root.dataset.activeIndex = String(center);
		}
		document.querySelectorAll<HTMLElement>('[data-spectacle-coverflow]').forEach((wrap) => {
			const items = [...wrap.querySelectorAll<HTMLButtonElement>('[data-coverflow-item]')];
			const list = items.map((b) => b.dataset.lightboxSrc ?? '').filter(Boolean);
			if (!list.length) return;
			let active = 0;
			let dragStartX: number | null = null;
			let dragDelta = 0;
			let dragged = false;
			let ignoreClick = false;
			let pointerItem: HTMLButtonElement | null = null;
			const CLICK_SLOP = 8;
			const SWIPE_THRESHOLD = 40;
			const setActive = (next: number) => {
				active = wrapIndex(next, list.length);
				renderCoverflow(wrap, active);
			};
			const openItem = (btn: HTMLButtonElement) => {
				const i = Number(btn.dataset.index ?? 0);
				setActive(i);
				openLightbox(list, i);
			};
			setActive(0);
			wrap.querySelector('[data-coverflow-prev]')?.addEventListener('click', (e) => {
				e.preventDefault();
				setActive(active - 1);
			});
			wrap.querySelector('[data-coverflow-next]')?.addEventListener('click', (e) => {
				e.preventDefault();
				setActive(active + 1);
			});
			wrap.querySelectorAll<HTMLElement>('[data-coverflow-dot]').forEach((dot) => {
				dot.addEventListener('click', () => {
					const i = Number(dot.dataset.index ?? 0);
					setActive(i);
				});
			});
			// Keyboard / fallback activation. Pointer path opens on pointerup because
			// stage.setPointerCapture retargets pointerup away from the item, so the
			// browser often never delivers click to the coverflow buttons.
			items.forEach((btn) => {
				btn.addEventListener('click', (e) => {
					if (ignoreClick || dragged) {
						e.preventDefault();
						ignoreClick = false;
						dragged = false;
						return;
					}
					openItem(btn);
				});
			});
			const stage = wrap.querySelector<HTMLElement>('[data-coverflow-stage]');
			if (!stage) return;
			const onPointerDown = (e: PointerEvent) => {
				if (e.pointerType === 'mouse' && e.button !== 0) return;
				const target = e.target as Element | null;
				pointerItem = target?.closest?.('[data-coverflow-item]') as HTMLButtonElement | null;
				dragStartX = e.clientX;
				dragDelta = 0;
				dragged = false;
				ignoreClick = false;
				stage.setPointerCapture(e.pointerId);
			};
			const onPointerMove = (e: PointerEvent) => {
				if (dragStartX == null) return;
				dragDelta = e.clientX - dragStartX;
				if (Math.abs(dragDelta) > CLICK_SLOP) dragged = true;
			};
			const endPointer = (e: PointerEvent, cancelled: boolean) => {
				if (dragStartX == null) return;
				try {
					if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
				} catch {
					/* already released */
				}
				if (!cancelled) {
					if (dragDelta <= -SWIPE_THRESHOLD) {
						setActive(active + 1);
						ignoreClick = true;
					} else if (dragDelta >= SWIPE_THRESHOLD) {
						setActive(active - 1);
						ignoreClick = true;
					} else if (!dragged && pointerItem) {
						// Tap / click without drag: open fullscreen for that visible photo.
						openItem(pointerItem);
						ignoreClick = true;
					}
				}
				dragStartX = null;
				dragDelta = 0;
				pointerItem = null;
			};
			stage.addEventListener('pointerdown', onPointerDown);
			stage.addEventListener('pointermove', onPointerMove);
			stage.addEventListener('pointerup', (e) => endPointer(e, false));
			stage.addEventListener('pointercancel', (e) => endPointer(e, true));
		});
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) closeLightbox();
		});
		dialog.querySelectorAll('[data-lightbox-close]').forEach((el) => {
			el.addEventListener('click', closeLightbox);
		});
		dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', (e) => {
			e.stopPropagation();
			show(index - 1);
		});
		dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', (e) => {
			e.stopPropagation();
			show(index + 1);
		});
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(index - 1);
			if (e.key === 'ArrowRight') show(index + 1);
		});
	}
</script>
