---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { readStudentsSorted, readAttendance } from '../lib/siteContent';
import { attendanceCellStatus, attendancePresentCount } from '../lib/attendanceStats';
import { attendanceSummary, plural, shortDate, sortLessonsNewest } from '../lib/programmka';

const students = await readStudentsSorted();
const { data: att } = await readAttendance();

// Самые новые занятия — слева (как и раньше).
const lessons = sortLessonsNewest(att.lessons ?? []);
const totalLessons = lessons.length;
const sum = attendanceSummary(
	lessons,
	students.map((s) => s.data.slug),
);
---

<Layout title="Явка" description="Посещаемость занятий группы КиТ20: зрительный зал, где кресло — занятие">
	<div class="page-top page-top--paper" aria-hidden="true"></div>
	<section class="paper sec" id="yavka" aria-labelledby="yavka-h">
		<div class="wrap">
			<header class="sec__h">
				<span class="sec__no">Перед началом</span>
				<h1 id="yavka-h" class="sec__title">Явка</h1>
				<p>Каждый ряд — исполнитель, каждое кресло — занятие. Красное кресло — был, пустое — не был. Свежие занятия слева.</p>
			</header>
			{
				totalLessons === 0 ? (
					<p class="empty">Нет данных.</p>
				) : (
					<div class="hall" id="hall">
						<div>
							<div class="scene-edge" aria-hidden="true" />
							<div class="seats-scroll">
								<table class="seats" id="att-table">
									<caption class="sr">
										Посещаемость: {totalLessons} {plural(totalLessons, 'занятие', 'занятия', 'занятий')}
									</caption>
									<thead>
										<tr>
											<th scope="col">
												<span class="sr">Исполнитель</span>
											</th>
											{lessons.map((l) => (
												<th scope="col">
													<span>{shortDate(l.date)}</span>
													<small>{l.label ?? '—'}</small>
												</th>
											))}
											<th scope="col">
												<span class="mono" title="Посещений из записанных занятий">Б/все</span>
											</th>
										</tr>
									</thead>
									<tbody>
										{students.map((s) => {
											const presentCount = attendancePresentCount(lessons, s.data.slug);
											return (
												<tr>
													<th scope="row">{s.data.displayName}</th>
													{lessons.map((l) => {
														const was = attendanceCellStatus(l, s.data.slug) === 'present';
														return (
															<td>
																<span
																	class:list={['seat', { 'seat--on': was }]}
																	role="img"
																	aria-label={`${shortDate(l.date)}${l.label ? ` (${l.label})` : ''}: ${was ? 'был(а)' : 'не был(а)'}`}
																	title={`${shortDate(l.date)} · ${l.label ?? ''} — ${was ? 'был(а)' : 'не был(а)'}`}
																/>
															</td>
														);
													})}
													<td class="seat__sum mono" title={`Был(а) на ${presentCount} из ${totalLessons} занятий`}>
														{presentCount}/{totalLessons}
													</td>
												</tr>
											);
										})}
									</tbody>
								</table>
							</div>
						</div>
						<aside>
							<p class="overline">Зал заполнен</p>
							<p class="big">
								{sum.pct}
								<small>%</small>
							</p>
							<p>
								{sum.present} из {sum.slots} мест за {totalLessons} {plural(totalLessons, 'занятие', 'занятия', 'занятий')}.
							</p>
							<p class="legend">
								<span><i class="on" />был</span>
								<span><i />не был</span>
							</p>
						</aside>
					</div>
				)
			}
		</div>
	</section>
</Layout>
