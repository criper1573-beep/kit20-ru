---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { readHome } from '../lib/siteContent';
import { renderMarkdownToHtml } from '../lib/renderMarkdown';
import type { HomeFrontmatter } from '../lib/schemas';

const { data, body } = await readHome();
const bodyHtml = renderMarkdownToHtml(body);
const title = data.title;

const defaultSemesters = [
	{ label: '2026/27 · семестр 1', progress: 20, color: 'accent' as const },
	{ label: '2026/27 · семестр 2', progress: 10, color: 'ink' as const },
	{ label: '2027/28 · семестр 1', progress: 10, color: 'ink' as const },
	{ label: '2027/28 · семестр 2', progress: 10, color: 'ink' as const },
];
const semesters = data.semesters?.length ? data.semesters : defaultSemesters;

function fontFamilyClass(f: HomeFrontmatter['titleFont']): string {
	if (f === 'sans') return 'font-sans';
	if (f === 'serif') return 'font-serif';
	return 'font-display';
}

function weightClass(w: HomeFrontmatter['titleWeight']): string {
	return w === 'bold' ? 'font-bold' : 'font-normal';
}

function progressFillClass(color: string | undefined): string {
	switch (color) {
		case 'accent':
			return 'bb-progress-fill--accent';
		case 'muted':
			return 'bb-progress-fill--muted';
		case 'mono':
			return 'bb-progress-fill--mono';
		default:
			return '';
	}
}

const titleFont = data.titleFont ?? 'display';
const titleWeight = data.titleWeight ?? 'normal';
const titleItalic = data.titleItalic ?? false;

const kitMatch = data.title.trim().match(/^(.*?)(?:\s+)(КИТ[-\s]?20.*)$/i);
const heroKicker = kitMatch?.[1]?.trim() ?? '';
const heroTitle = kitMatch?.[2]?.trim() || data.title.trim();
---

<Layout title={title}>
	<section
		class="relative mb-12 overflow-hidden border-[3px] border-ink bg-surface px-8 pb-8 pt-8 shadow-[var(--shadow-card)] sm:px-12 sm:pb-12 sm:pt-12"
	>
		<h1 class="text-center">
			{
				heroKicker && (
					<span
						class:list={[
							'mb-2 block text-lg uppercase leading-none tracking-[0.22em] text-ink sm:text-xl',
							fontFamilyClass(titleFont),
							weightClass(titleWeight),
							titleItalic ? 'italic' : 'not-italic',
						]}
					>
						{heroKicker}
					</span>
				)
			}
			<span
				id="home-hero-title"
				class:list={[
					'inline-block text-5xl uppercase leading-[0.95] tracking-[0.08em] text-ink sm:text-6xl lg:text-7xl',
					fontFamilyClass(titleFont),
					weightClass(titleWeight),
					titleItalic ? 'italic' : 'not-italic',
				]}
			>
				{heroTitle}
			</span>
		</h1>

		{
			data.photo && (
				<div class="-mx-8 mt-8 overflow-hidden border-y-[3px] border-ink bg-muted-surface sm:-mx-12">
					<img
						src={data.photo}
						alt="Фото группы"
						class="h-[min(70vw,36rem)] w-full object-cover object-center"
					/>
				</div>
			)
		}

		<div class="mt-10 max-w-3xl border-t-[3px] border-ink pt-8">
			<h2 class="mb-4 font-display text-lg uppercase tracking-[0.18em] text-ink font-normal">
				Учебные семестры <span class="whitespace-nowrap">(2 года)</span>
			</h2>
			<div class="flex flex-col gap-5">
				{
					semesters.map((s) => (
						<div>
							<div class="bb-progress-label text-ink/85">{s.label}</div>
							<div class="bb-progress-bar">
								<div
									class:list={['bb-progress-fill h-full', progressFillClass(s.color)]}
									style={`width: ${s.progress}%`}
								/>
							</div>
						</div>
					))
				}
			</div>
		</div>

		{
			bodyHtml.trim() && (
				<div class="markdown-body mt-10 max-w-3xl border-t-[3px] border-ink pt-8" set:html={bodyHtml} />
			)
		}
	</section>
</Layout>

<script is:inline define:vars={{ homeTitle: heroTitle }}>
	(function () {
		const CHARS =
			'АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЩЫЬЭЮЯabcdefghijklmnopqrstuvwxyz0123456789@#$%&';
		const el = document.getElementById('home-hero-title');
		if (!el) return;
		const original = homeTitle;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function attachGlitch() {
			el.setAttribute('data-text', original);
			el.classList.add('glitch-title');
		}

		if (reduced) {
			el.textContent = original;
			return;
		}

		let iter = 0;
		const id = window.setInterval(() => {
			el.textContent = original
				.split('')
				.map((c, i) => {
					if (c === ' ') return ' ';
					if (i < Math.floor(iter)) return original[i];
					return CHARS[Math.floor(Math.random() * CHARS.length)];
				})
				.join('');
			iter += 0.45;
			if (iter >= original.length + 2) {
				window.clearInterval(id);
				el.textContent = original;
				attachGlitch();
			}
		}, 32);
	})();
</script>
