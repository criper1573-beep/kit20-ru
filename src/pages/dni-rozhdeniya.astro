---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import StudentAvatar from '../components/StudentAvatar.astro';
import { readStudentsSorted } from '../lib/siteContent';
import { readBirthdayDialLayoutFile } from '../lib/birthdayDialLayoutFile';
import { renderMarkdownToHtml } from '../lib/renderMarkdown';
import { dayMonth, dayMonthText } from '../lib/programmka';

const rows = await readStudentsSorted();
// Публично — только день и месяц: год рождения в разметку не попадает (152-ФЗ).
const payload: { displayName: string; m: number; d: number; slug: string }[] = [];
const cards: { slug: string; data: (typeof rows)[0]['data']; bodyHtml: string; variant: number; bd: string }[] = [];
let v = 0;
for (const r of rows) {
	const dm = dayMonth(r.data.birthday);
	if (!dm) continue;
	payload.push({ slug: r.data.slug, displayName: r.data.displayName, m: dm.m, d: dm.d });
	cards.push({ slug: r.data.slug, data: r.data, bodyHtml: renderMarkdownToHtml(r.body), variant: v, bd: dayMonthText(r.data.birthday) ?? '' });
	v += 1;
}
const list = [...payload].sort((a, b) => a.m - b.m || a.d - b.d);
const layoutOverrides = await readBirthdayDialLayoutFile();
---

<Layout title="Дни рождения" description="Дни рождения группы КиТ20 на годовом круге">
	<div class="page-top page-top--paper" aria-hidden="true"></div>
	<section class="paper sec" id="dr" aria-labelledby="dr-h">
		<div class="wrap">
			<header class="sec__h">
				<span class="sec__no">Эпилог</span>
				<h1 id="dr-h" class="sec__title">Дни рождения</h1>
				<p>Год по кругу. Красная стрелка — сегодня, красная точка — ближайший праздник. Нажмите на имя — откроется карточка.</p>
			</header>
			<div id="bd-banner" class="bd-banner hidden" role="status"><p></p></div>
			<div class="bdays">
				<svg id="bd-dial" class="bd-dial" viewBox="-22 -22 244 244" role="group" aria-label="Дни рождения группы на годовом круге">
					<circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="1.2" class="track" />
					<g id="bd-months" />
					<g id="bd-segments" />
					<text class="center-t" x="100" y="106" id="bd-ring-days">—</text>
					<text class="center-s" x="100" y="118">дней до праздника</text>
					<g id="bd-dots" />
					<line id="bd-hand" class="now" x1="100" y1="100" x2="100" y2="32" stroke-linecap="round" pointer-events="none" />
					<circle cx="100" cy="100" r="2.6" class="hub" pointer-events="none" />
				</svg>
				<div>
					<p class="overline" data-bd-today>Сегодня</p>
					<p class="bd-next" data-bd-next>—</p>
					<ul class="bdlist">
						{list.map((x) => (
							<li data-m={x.m} data-d={x.d} data-slug={x.slug}>
								<span class="mono">{String(x.d).padStart(2, '0')}.{String(x.m).padStart(2, '0')}</span>
								<button type="button" class="bdlist__btn" data-open-actor={x.slug}>{x.displayName}</button>
							</li>
						))}
					</ul>
					<p class="privacy">Год рождения на открытой странице не показываем: дата с годом — лишние персональные данные.</p>
				</div>
			</div>
		</div>
	</section>

	{
		cards.map(({ slug, data, bodyHtml, variant, bd }) => (
			<dialog class="actor" id={`actor-${slug}`} aria-labelledby={`actor-${slug}-h`}>
				<form method="dialog">
					<button class="actor__x" aria-label="Закрыть">×</button>
				</form>
				{data.photo ? (
					<img src={data.photo} alt={`${data.displayName}, портрет`} width="220" height="220" loading="lazy" decoding="async" />
				) : (
					<span class="actor__svg"><StudentAvatar variant={variant} displayName={data.displayName} class="h-full w-full" /></span>
				)}
				<div>
					<p class="mono">Исполнитель · день рождения {bd}</p>
					<h3 id={`actor-${slug}-h`}>{data.displayName}</h3>
					<p class="actor__fio">{data.fullName}</p>
					{bodyHtml.trim() && <div class="markdown-body prog-md" set:html={bodyHtml} />}
				</div>
			</dialog>
		))
	}

	<script is:inline type="application/json" id="bd-payload" set:html={JSON.stringify(payload)}></script>
	<script is:inline type="application/json" id="bd-layout-overrides" set:html={JSON.stringify(layoutOverrides)}></script>
	<script is:inline>
		document.querySelectorAll('[data-open-actor]').forEach(function (b) {
			b.addEventListener('click', function () {
				var d = document.getElementById('actor-' + b.getAttribute('data-open-actor'));
				if (d && typeof d.showModal === 'function') d.showModal();
			});
		});
		document.querySelectorAll('dialog.actor').forEach(function (d) {
			d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
		});
	</script>

	<script>
		import {
			getNextBirthdayEventInfo,
			dialAngleDegFromTop,
			daysInYear,
			dayOfYearForDateInYear,
			dayOfYearInYear,
			parseBirthdayDmy,
		} from '../lib/birthdayUtils';
		import { computeBirthdayDialPlacements, polarFromTopDeg } from '../lib/birthdayDialGeometry';
		import { createBirthdayDialItem } from '../lib/birthdayDialDom';
		import type { BirthdayLabelOverride } from '../lib/birthdayDialLayoutFile';

		type Row = { displayName: string; m: number; d: number; birthday: string; slug: string };

		const MONTHS_GEN = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
		function renderSide(
			rows: Row[],
			nextEv: { daysUntil: number; names: string[]; eventDate: Date } | null,
			now: Date,
		) {
			const nx = document.querySelector('[data-bd-next]');
			const tdy = document.querySelector('[data-bd-today]');
			const ring = document.getElementById('bd-ring-days');
			if (!nextEv || rows.length === 0) {
				if (nx) nx.textContent = 'Дат пока нет';
				return;
			}
			if (ring) ring.textContent = String(nextEv.daysUntil);
			const same = nextEv.names.join(' и ');
			if (nx) {
				nx.textContent = nextEv.daysUntil === 0 ? 'Сегодня — ' : 'Следующий — ';
				const sp = document.createElement('span');
				sp.textContent = same;
				nx.appendChild(sp);
			}
			if (tdy) {
				tdy.textContent =
					'Сегодня ' + now.getDate() + ' ' + MONTHS_GEN[now.getMonth()] + ' · до праздника ' + nextEv.daysUntil + ' ' + declensionDays(nextEv.daysUntil);
			}
			const em = nextEv.eventDate.getMonth() + 1;
			const ed = nextEv.eventDate.getDate();
			document.querySelectorAll('.bdlist li').forEach((li) => {
				const on = Number(li.getAttribute('data-m')) === em && Number(li.getAttribute('data-d')) === ed;
				li.classList.toggle('is-next', on);
			});
			document.querySelectorAll('#bd-dots [data-birthday-slug]').forEach((g) => {
				const slug = g.getAttribute('data-birthday-slug');
				const li = slug ? document.querySelector(`.bdlist li[data-slug="${slug}"]`) : null;
				g.classList.toggle('is-next', Boolean(li?.classList.contains('is-next')));
			});
		}

		const MONTHS = ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'] as const;

		function declensionDays(n: number): string {
			const mod10 = n % 10;
			const mod100 = n % 100;
			if (mod10 === 1 && mod100 !== 11) return 'день';
			if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return 'дня';
			return 'дней';
		}

		function handAngle(now: Date): { deg: number } {
			const y = now.getFullYear();
			const len = daysInYear(y);
			const noon = new Date(
				now.getFullYear(),
				now.getMonth(),
				now.getDate(),
				12,
				0,
				0,
				0,
			);
			const doy = dayOfYearInYear(noon);
			return { deg: dialAngleDegFromTop(doy, len) };
		}

		/** Месяцы — внутри кольца; рисочки — не заходят за обод, чтобы снаружи остались место для имён. */
		const R_M_TICK_IN = 52;
		const R_M_TICK_OUT = 86;
		const R_M_LABEL = 60;

		function renderMonthMarks(svg: SVGSVGElement, y: number) {
			const gSeg = document.getElementById('bd-segments');
			const gMo = document.getElementById('bd-months');
			if (!gSeg || !gMo) return;
			gSeg.replaceChildren();
			gMo.replaceChildren();
			const lenY = daysInYear(y);
			const cx = 100;
			const cy = 100;
			for (let m = 1; m <= 12; m++) {
				const doy1 = dayOfYearForDateInYear(y, m, 1);
				const a = dialAngleDegFromTop(doy1, lenY);
				const p0 = polarFromTopDeg(a, R_M_TICK_IN, cx, cy);
				const p1 = polarFromTopDeg(a, R_M_TICK_OUT, cx, cy);
				const el = document.createElementNS('http://www.w3.org/2000/svg', 'line');
				el.setAttribute('x1', String(p0.x));
				el.setAttribute('y1', String(p0.y));
				el.setAttribute('x2', String(p1.x));
				el.setAttribute('y2', String(p1.y));
				el.setAttribute('stroke', 'currentColor');
				el.setAttribute('stroke-width', '0.8');
				el.setAttribute('opacity', '0.45');
				gSeg.appendChild(el);

				const midDoy = dayOfYearForDateInYear(y, m, 15);
				const aLab = dialAngleDegFromTop(midDoy, lenY);
				const tpos = polarFromTopDeg(aLab, R_M_LABEL, cx, cy);
				const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
				t.setAttribute('x', String(tpos.x));
				t.setAttribute('y', String(tpos.y + 1));
				t.setAttribute('text-anchor', 'middle');
				t.setAttribute('dominant-baseline', 'middle');
				t.setAttribute('font-size', '8.5');
				t.setAttribute('class', 'font-mono uppercase');
				t.textContent = MONTHS[m - 1] ?? '';
				gMo.appendChild(t);
			}
		}

		function run() {
			const raw = document.getElementById('bd-payload')?.textContent;
			// В разметке нет года рождения (152-ФЗ): движку циферблата нужна строка ДД.ММ.ГГГГ,
			// подставляем технический високосный год 2000 только в памяти (29.02 тоже валиден).
			const rows: Row[] = (raw ? (JSON.parse(raw) as Omit<Row, 'birthday'>[]) : []).map((r) => ({
				...r,
				birthday: `${String(r.d).padStart(2, '0')}.${String(r.m).padStart(2, '0')}.2000`,
			}));
			const now = new Date();
			const y = now.getFullYear();
			const lenY = daysInYear(y);

			const withParts = rows
				.map((r) => ({ r, parts: parseBirthdayDmy(r.birthday) }))
				.filter((x) => x.parts != null) as { r: Row; parts: { day: number; month: number; year: number } }[];
			const partRows = withParts.map(({ r, parts }) => ({ displayName: r.displayName, parts }));
			const nextEv = getNextBirthdayEventInfo(partRows, now);
			const daysUntil = nextEv?.daysUntil ?? 0;
			const todayNames = nextEv && nextEv.daysUntil === 0 ? nextEv.names : [];

			const bEl = document.getElementById('bd-banner');
			const pBanner = bEl?.querySelector('p');
			if (bEl && pBanner) {
				if (todayNames.length > 0) {
					const n = todayNames;
					const tail = n.length === 1 ? n[0] : n.slice(0, -1).join(', ') + ' и ' + n[n.length - 1];
					pBanner.textContent = `С днём рождения, ${tail}!`;
					bEl.classList.remove('hidden');
				} else {
					bEl.classList.add('hidden');
				}
			}

			const todayEl = document.getElementById('bd-today');
			if (todayEl) {
				const todayStr = new Intl.DateTimeFormat('ru-RU', {
					day: 'numeric',
					month: 'long',
					year: 'numeric',
					weekday: 'long',
				}).format(now);
				// «г.» не переносим отдельно от года
				todayEl.textContent = todayStr.replace(/ (\u0433\.)$/, '\u00a0$1');
			}
			const untilEl = document.getElementById('bd-until');
			const untilSub = document.getElementById('bd-until-sub');
			const dateFmt = new Intl.DateTimeFormat('ru-RU', {
				day: 'numeric',
				month: 'long',
				year: 'numeric',
			});
			if (untilEl) {
				untilEl.removeAttribute('aria-describedby');
				if (rows.length === 0) {
					untilEl.textContent = 'Нет дат в карточках';
					if (untilSub) untilSub.textContent = '';
				} else {
					untilEl.textContent = `${daysUntil} ${declensionDays(daysUntil)}`;
					if (untilSub && nextEv) {
						const who = nextEv.names.join(', ');
						if (nextEv.daysUntil === 0) {
							untilSub.textContent = who ? `Сегодня: ${who}` : '';
						} else {
							const when = dateFmt.format(nextEv.eventDate);
							untilSub.textContent = who ? `${when} — ${who}` : '';
						}
						if (untilSub.textContent) untilEl.setAttribute('aria-describedby', 'bd-until-sub');
					} else if (untilSub) {
						untilSub.textContent = '';
					}
				}
			}

			const hand = document.getElementById('bd-hand') as SVGLineElement | null;
			if (hand) {
				const h = handAngle(now);
				const tip = polarFromTopDeg(h.deg, 76, 100, 100);
				hand.setAttribute('x2', String(tip.x));
				hand.setAttribute('y2', String(tip.y));
			}

			const svg = document.getElementById('bd-dial') as SVGSVGElement | null;
			if (svg) {
				renderMonthMarks(svg, y);
			}

			const gDots = document.getElementById('bd-dots');
			if (gDots) {
				gDots.replaceChildren();
				const rawOvr = document.getElementById('bd-layout-overrides')?.textContent;
				let layoutMap: Record<string, BirthdayLabelOverride> = {};
				if (rawOvr) {
					try {
						const j = JSON.parse(rawOvr) as unknown;
						if (j && typeof j === 'object' && !Array.isArray(j)) layoutMap = j as typeof layoutMap;
					} catch {
						/* keep empty */
					}
				}
				const placements = computeBirthdayDialPlacements(rows, y, lenY, layoutMap);
				for (const p of placements) {
					const nodes = createBirthdayDialItem(p, { interactive: true });
					const parts = p.birthday.split('.');
					const human = `${Number(parts[0])} ${MONTHS_GEN[Number(parts[1]) - 1] ?? ''}`;
					nodes.g.setAttribute('aria-label', `Карточка: ${p.displayName}, ${human}`);
					nodes.text.setAttribute('title', `${p.displayName} — ${human}`);
					nodes.circle.setAttribute('r', '2.8');
					gDots.appendChild(nodes.g);
				}
				renderSide(rows, nextEv, now);
			}
		}

		function openBirthdayDialogBySlug(slug: string) {
			const el = document.getElementById(`actor-${slug}`);
			if (el instanceof HTMLDialogElement) {
				el.showModal();
			}
		}

		function setupBirthdayDialPointer() {
			const dial = document.getElementById('bd-dial');
			if (!dial || (dial as unknown as { _bdPtr?: boolean })._bdPtr) return;
			(dial as unknown as { _bdPtr?: boolean })._bdPtr = true;
			dial.addEventListener('click', (e) => {
				if (!(e.target instanceof Element)) return;
				const g = e.target.closest?.('[data-birthday-slug]');
				if (g) {
					const slug = g.getAttribute('data-birthday-slug');
					if (slug) {
						e.preventDefault();
						e.stopPropagation();
						openBirthdayDialogBySlug(slug);
					}
				}
			});
			dial.addEventListener('keydown', (e) => {
				if (e.key !== 'Enter' && e.key !== ' ') return;
				const g = (e.target as Element | null)?.closest?.('[data-birthday-slug]');
				if (g) {
					const slug = g.getAttribute('data-birthday-slug');
					if (slug) {
						e.preventDefault();
						openBirthdayDialogBySlug(slug);
					}
				}
			});
		}

		setupBirthdayDialPointer();
		run();
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') run();
		});
		// смена даты без перезагрузки (на всякий случай раз в 6 ч)
		setInterval(
			() => {
				run();
			},
			6 * 60 * 60 * 1000,
		);
	</script>
</Layout>
