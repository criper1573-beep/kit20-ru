---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import StudentAvatar from '../components/StudentAvatar.astro';
import { readObshchak, readStudentsSorted } from '../lib/siteContent';
import {
	balanceKopeksBySlug,
	contributedKopeksTotal,
	expensesTotalKopeks,
	totalPotKopeks,
} from '../lib/obshchakMath';
import { fmtRub } from '../lib/programmka';

const students = await readStudentsSorted();
const slugs = students.map((s) => s.slug);

const data = await readObshchak();
const watcherSlug = data.watcherSlug;
const bySlug = new Map(students.map((r, i) => [r.data.slug, { row: r, i }]));

// Математика — без изменений (src/lib/obshchakMath.ts): касса = взносы + архив выбывших − траты; баланс = взнос − доля.
const archived = data.archivedContributedKopeks ?? {};
const potK = totalPotKopeks(data.contributedKopeks, data.expenses, archived);
const balMap = balanceKopeksBySlug(slugs, data.contributedKopeks, data.expenses);
const contribK = contributedKopeksTotal(data.contributedKopeks) + contributedKopeksTotal(archived);
const spentK = expensesTotalKopeks(data.expenses);

const watcher = bySlug.get(watcherSlug);
if (!watcher) {
	throw new Error(`obshchak: смотрящий «${watcherSlug}» не найден в списке учеников`);
}
const others = students.filter((s) => s.data.slug !== watcherSlug);
const maxAbs = Math.max(1, ...others.map((s) => Math.abs(balMap.get(s.slug) ?? 0)));

const expenses = [...(data.expenses ?? [])].sort((a, b) => {
	const ta = a.createdAt ? Date.parse(a.createdAt) : 0;
	const tb = b.createdAt ? Date.parse(b.createdAt) : 0;
	if (ta !== tb) return tb - ta;
	return b.id.localeCompare(a.id, 'en');
});
const dateFmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Moscow' });
const nameOf = (slug: string) => bySlug.get(slug)?.row.data.displayName ?? slug;
const watcherBal = balMap.get(watcherSlug) ?? 0;
---

<Layout title="Касса" description="Общак группы КиТ20: взносы, равные доли в тратах, балансы">
	<div class="page-top" aria-hidden="true"></div>
	<section class="sec" id="kassa" aria-labelledby="kassa-h">
		<div class="wrap">
			<header class="sec__h">
				<span class="sec__no">Антракт</span>
				<h1 id="kassa-h" class="sec__title">Касса</h1>
				<p>Общак: взносы и равные доли в тратах. Честно до копейки.</p>
			</header>
			<div class="till">
				<div>
					<div class="ticket reveal">
						<p class="overline">В кассе сейчас</p>
						<p class="sum">{fmtRub(potK)}<small>₽</small></p>
						<div class="perf" aria-hidden="true"></div>
						<div class="calc">
							<span>Внесено{Object.keys(archived).length > 0 ? ' (с взносами выбывших)' : ''}</span><b>{fmtRub(contribK)} ₽</b>
							<span>Потрачено</span><b>−{fmtRub(spentK)} ₽</b>
							<span class="eq">Остаток</span><b class="eq">{fmtRub(potK)} ₽</b>
						</div>
						<div class="watch">
							{watcher.row.data.photo ? (
								<img src={watcher.row.data.photo} alt="" width="64" height="64" loading="lazy" decoding="async" />
							) : (
								<span class="watch__svg"><StudentAvatar variant={watcher.i} displayName={watcher.row.data.displayName} class="h-full w-full" /></span>
							)}
							<div>
								<span class="mono">Смотрящий</span>
								<b>{watcher.row.data.displayName}</b>
								<span class:list={['mono', { neg: watcherBal < 0 }]}>личный баланс {fmtRub(watcherBal)} ₽</span>
							</div>
						</div>
					</div>
					<p class="motto">Тут не Питер на развод, но честно до копейки: доля на всех, как на крыше.</p>
				</div>
				<div>
					<h2 class="h3">Баланс по группе</h2>
					<ul class="bals">
						{others.map((s) => {
							const b = balMap.get(s.slug) ?? 0;
							const cls = b < 0 ? 'neg' : b === 0 ? 'zero' : 'pos';
							return (
								<li class={`bal bal--${cls}`} style={`--w:${((Math.abs(b) / maxAbs) * 100).toFixed(1)}`}>
									<span class="bal__n">{s.data.displayName}</span>
									<span class="bal__track"><b /></span>
									<span class="bal__v mono">{fmtRub(b)} ₽</span>
								</li>
							);
						})}
					</ul>
					<h2 class="h3">Траты</h2>
					{expenses.length === 0 ? (
						<p class="empty">Пока нет записанных трат.</p>
					) : (
						<ul class="receipt">
							{expenses.map((e) => (
								<li>
									<span class="mono">
										{e.createdAt ? dateFmt.format(new Date(e.createdAt)).replace(/\s?г\.$/, '') : 'дата не указана'}
										{(() => {
											const ps = e.participantSlugs ?? [];
											const outside = ps.length > 0 ? slugs.filter((x) => !ps.includes(x)) : [];
											return outside.length > 0 ? <> · без доли: {outside.map(nameOf).join(', ')}</> : null;
										})()}
									</span>
									<span class="l">{e.label}</span>
									<b>{fmtRub(e.amountKopeks)} ₽</b>
								</li>
							))}
							<li class="tot">
								<span class="l">Итого по чеку</span>
								<b>{fmtRub(spentK)} ₽</b>
							</li>
						</ul>
					)}
				</div>
			</div>
		</div>
	</section>
</Layout>
