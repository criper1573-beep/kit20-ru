---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import EtudeTopicSheets from '../components/EtudeTopicSheets.astro';
import StudentProfileDialogs from '../components/StudentProfileDialogs.astro';
import { readEtudeTopics, readStudentsSorted } from '../lib/siteContent';
import { etudesForTopic, pickActiveTopic, sortTopicsNewestLeft, topicHidesEtudeTitle } from '../lib/etudeTopics';

const students = await readStudentsSorted();
const catalog = await readEtudeTopics();
const topics = sortTopicsNewestLeft(catalog.topics);
const active = pickActiveTopic(topics, Astro.url.searchParams.get('topic'));
const orderBySlug = new Map(students.map((s) => [s.slug, s.data.order]));

const rows = active
	? etudesForTopic(catalog.etudes, active.id).slice().sort((a, b) => {
			const ao = orderBySlug.get(a.participantSlugs[0] ?? '') ?? 9999;
			const bo = orderBySlug.get(b.participantSlugs[0] ?? '') ?? 9999;
			if (ao !== bo) return ao - bo;
			return (a.title || a.id).localeCompare(b.title || b.id, 'ru');
		})
	: [];
const hideTitle = topicHidesEtudeTitle(active);

const studentBySlug = new Map(students.map((s) => [s.slug, s]));
const studentBlocks = students.map((entry, i) => ({
	slug: entry.slug,
	data: entry.data,
	variant: i,
}));
---

<Layout title="Класс" description="Темы этюдов и комментарии педагога">
	<EtudeTopicSheets slot="after-ticker" topics={topics} activeId={active?.id ?? null} basePath="/class" />

	{
		active && (
			<h1 class="mb-6 inline-flex max-w-full items-center border-[3px] border-ink bg-accent px-2.5 py-1.5 shadow-[var(--shadow-card)] sm:px-4 sm:py-2">
				<span class="whitespace-nowrap font-display text-[clamp(1.25rem,6.4vw,2.75rem)] font-normal uppercase leading-none tracking-[0.06em] text-canvas sm:tracking-[0.12em]">
					{active.title}
				</span>
			</h1>
		)
	}

	{
		!active ? (
			<div class="border-[3px] border-dashed border-ink bg-muted-surface p-8 text-center font-sans text-sm uppercase text-muted">
				Нет тем этюдов.
			</div>
		) : rows.length === 0 ? (
			<div class="border-[3px] border-dashed border-ink bg-muted-surface p-8 text-center font-sans text-sm uppercase text-muted">
				В этой теме пока нет этюдов.
			</div>
		) : (
			<div class="bb-scrollbar max-w-full overflow-x-auto border-[3px] border-ink bg-surface shadow-[var(--shadow-card)]">
				<table class="kit-data-table text-left font-sans text-[10px] sm:text-sm" id="class-etudes-table">
					<thead>
						<tr class="border-b-[3px] border-ink bg-ink text-canvas">
							<th class:list={[
								'border-r-[2px] border-ink px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base sm:tracking-wider',
								hideTitle ? 'w-[38%]' : 'w-[30%]',
							]}>
								Участники
							</th>
							{
								!hideTitle && (
									<th class="w-[28%] border-r-[2px] border-ink/20 px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base sm:tracking-wider">
										Название этюда
									</th>
								)
							}
							<th class="px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base sm:tracking-wider">
								Комментарий педагога
							</th>
						</tr>
					</thead>
					<tbody>
						{rows.map((row) => (
							<tr class="border-b-[2px] border-ink/20 last:border-0 hover:bg-muted-surface">
								<td class="border-r-[2px] border-ink px-1.5 py-2 align-top uppercase tracking-normal text-ink sm:px-4 sm:py-3 sm:tracking-wider">
									<div class="flex flex-wrap gap-x-2 gap-y-1">
										{row.participantSlugs.length === 0 ? (
											<span class="text-muted">—</span>
										) : (
											row.participantSlugs.map((slug) => {
												const s = studentBySlug.get(slug);
												const label = s?.data.displayName ?? slug;
												return (
													<button
														type="button"
														class="etude-participant border-b-[2px] border-transparent text-left uppercase hover:border-accent"
														data-open-profile={slug}
													>
														{label}
													</button>
												);
											})
										)}
									</div>
								</td>
								{
									!hideTitle && (
										<td class="border-r-[2px] border-ink/20 px-1.5 py-2 align-top uppercase text-ink sm:px-4 sm:py-3">
											{row.title?.trim() ? row.title : '—'}
										</td>
									)
								}
								<td class="px-1.5 py-2 align-top text-ink/90 normal-case sm:px-4 sm:py-3">
									{row.teacherComment?.trim() ? row.teacherComment : '—'}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}

	<StudentProfileDialogs students={studentBlocks} />
</Layout>
