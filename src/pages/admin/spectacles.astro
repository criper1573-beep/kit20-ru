---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { hasValidAdminSession } from '../../lib/adminApiAuth';
import { readSpectacles } from '../../lib/siteContent';
import { sortSpectacles } from '../../lib/spectacles';

if (!hasValidAdminSession(Astro.cookies)) {
	const nextUrl = Astro.url.pathname + Astro.url.search;
	return Astro.redirect(`/admin/login?next=${encodeURIComponent(nextUrl)}`);
}

const { spectacles } = await readSpectacles();
const list = sortSpectacles(spectacles);
---

<Layout admin title="Спектакли · редактирование">
	<section class="border-[3px] border-ink bg-surface p-6 shadow-[var(--shadow-card)] sm:p-8">
		<div class="mb-6 flex flex-wrap items-start justify-between gap-4 border-b-[3px] border-ink pb-4">
			<div>
				<h1 class="font-display text-3xl font-normal uppercase tracking-widest text-ink sm:text-4xl">Спектакли</h1>
				<p class="mt-2 font-sans text-xs uppercase tracking-wider text-muted">
					Файл: <code class="border-[2px] border-ink bg-muted-surface px-1.5 py-0.5 text-ink">src/content/spectacles.json</code>
				</p>
				<p class="mt-2 max-w-xl font-sans text-xs uppercase tracking-wider text-muted">
					Блок на главной. Пустой список — секция скрыта. Выше в списке — выше на странице.
				</p>
			</div>
			<a
				href="/"
				class="border-[3px] border-ink bg-surface px-4 py-2 font-sans text-xs uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift"
			>
				На сайт
			</a>
		</div>

		<div id="spectacle-list" class="space-y-6">
			{
				list.map((spec, index) => (
					<article class="spec-row border-[3px] border-ink bg-canvas/30 p-4 shadow-[var(--shadow-card)] sm:p-5" data-spec-row data-spec-id={spec.id}>
						<div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-[2px] border-ink pb-3">
							<p class="font-display text-xl uppercase tracking-widest text-ink">
								Спектакль <span class="text-muted" data-spec-index>{index + 1}</span>
							</p>
							<div class="flex flex-wrap gap-2">
								<button type="button" data-spec-up class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest hover:bg-accent hover:text-canvas active-shift">
									↑ Вверх
								</button>
								<button type="button" data-spec-down class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest hover:bg-accent hover:text-canvas active-shift">
									↓ Вниз
								</button>
								<button type="button" data-spec-remove class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest text-accent hover:bg-accent hover:text-canvas active-shift">
									Удалить
								</button>
							</div>
						</div>

						<div class="grid gap-4 sm:grid-cols-2">
							<label class="block font-sans text-xs uppercase tracking-wider text-muted sm:col-span-2">
								Название
								<input
									type="text"
									data-spec-title
									value={spec.title}
									class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent"
								/>
							</label>
							<div class="block font-sans text-xs uppercase tracking-wider text-muted">
								Герой-фото
								<input type="hidden" data-spec-hero value={spec.heroPhoto} />
								<div class="mt-2 flex items-center gap-3">
									<img
										data-spec-hero-preview
										src={spec.heroPhoto}
										alt=""
										class="h-20 w-28 border-[3px] border-ink object-cover"
										style={spec.heroPhoto ? '' : 'display:none'}
									/>
									<label class="cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
										Загрузить
										<input type="file" accept="image/*" data-spec-hero-upload class="hidden" />
									</label>
								</div>
							</div>
							<div class="block font-sans text-xs uppercase tracking-wider text-muted">
								Фото режиссёра
								<input type="hidden" data-spec-director-photo value={spec.directorPhoto} />
								<div class="mt-2 flex items-center gap-3">
									<img
										data-spec-director-preview
										src={spec.directorPhoto}
										alt=""
										class="h-20 w-20 border-[3px] border-ink object-cover"
										style={spec.directorPhoto ? '' : 'display:none'}
									/>
									<label class="cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
										Загрузить
										<input type="file" accept="image/*" data-spec-director-upload class="hidden" />
									</label>
								</div>
							</div>
							<label class="block font-sans text-xs uppercase tracking-wider text-muted">
								Имя режиссёра
								<input
									type="text"
									data-spec-director-name
									value={spec.directorName}
									class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent"
								/>
							</label>
							<label class="block font-sans text-xs uppercase tracking-wider text-muted">
								Регалии
								<input
									type="text"
									data-spec-director-regalia
									value={spec.directorRegalia}
									class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent"
								/>
							</label>
						</div>

						<div class="mt-4 border-t-[2px] border-ink pt-4">
							<p class="font-sans text-xs uppercase tracking-wider text-muted">Галерея</p>
							<div data-spec-gallery class="mt-3 flex flex-wrap gap-3">
								{spec.gallery.map((url) => (
									<div class="spec-gal relative border-[3px] border-ink bg-muted-surface p-1" data-gal-item>
										<input type="hidden" data-gal-url value={url} />
										<img src={url} alt="" class="h-20 w-28 object-cover" />
										<button
											type="button"
											data-gal-remove
											class="absolute right-1 top-1 flex h-6 w-6 items-center justify-center border-[2px] border-ink bg-surface text-xs hover:bg-accent hover:text-canvas"
											title="Удалить кадр"
										>
											✕
										</button>
									</div>
								))}
							</div>
							<label class="mt-3 inline-block cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 font-sans text-[10px] uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
								+ Кадры
								<input type="file" accept="image/*" multiple data-spec-gallery-upload class="hidden" />
							</label>
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-6 flex flex-wrap items-center gap-3">
			<button
				type="button"
				id="spec-add"
				class="border-[3px] border-ink bg-surface px-4 py-2 font-sans text-sm uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift"
			>
				Добавить спектакль
			</button>
			<button
				type="button"
				id="spec-save"
				class="border-[3px] border-ink bg-accent px-6 py-2 font-display text-xl tracking-widest text-canvas shadow-[var(--shadow-card)] hover:bg-accent-hover active-shift"
			>
				Сохранить
			</button>
			<span id="spec-status" class="font-sans text-sm uppercase text-muted"></span>
		</div>
	</section>

<template id="spec-row-tpl">
	<article class="spec-row border-[3px] border-ink bg-canvas/30 p-4 shadow-[var(--shadow-card)] sm:p-5" data-spec-row>
		<div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-[2px] border-ink pb-3">
			<p class="font-display text-xl uppercase tracking-widest text-ink">
				Спектакль <span class="text-muted" data-spec-index></span>
			</p>
			<div class="flex flex-wrap gap-2">
				<button type="button" data-spec-up class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest hover:bg-accent hover:text-canvas active-shift">
					↑ Вверх
				</button>
				<button type="button" data-spec-down class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest hover:bg-accent hover:text-canvas active-shift">
					↓ Вниз
				</button>
				<button type="button" data-spec-remove class="border-[2px] border-ink bg-surface px-3 py-1.5 font-sans text-[10px] uppercase tracking-widest text-accent hover:bg-accent hover:text-canvas active-shift">
					Удалить
				</button>
			</div>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			<label class="block font-sans text-xs uppercase tracking-wider text-muted sm:col-span-2">
				Название
				<input type="text" data-spec-title class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
			</label>
			<div class="block font-sans text-xs uppercase tracking-wider text-muted">
				Герой-фото
				<input type="hidden" data-spec-hero value="" />
				<div class="mt-2 flex items-center gap-3">
					<img data-spec-hero-preview src="" alt="" class="h-20 w-28 border-[3px] border-ink object-cover" style="display:none" />
					<label class="cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
						Загрузить
						<input type="file" accept="image/*" data-spec-hero-upload class="hidden" />
					</label>
				</div>
			</div>
			<div class="block font-sans text-xs uppercase tracking-wider text-muted">
				Фото режиссёра
				<input type="hidden" data-spec-director-photo value="" />
				<div class="mt-2 flex items-center gap-3">
					<img data-spec-director-preview src="" alt="" class="h-20 w-20 border-[3px] border-ink object-cover" style="display:none" />
					<label class="cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
						Загрузить
						<input type="file" accept="image/*" data-spec-director-upload class="hidden" />
					</label>
				</div>
			</div>
			<label class="block font-sans text-xs uppercase tracking-wider text-muted">
				Имя режиссёра
				<input type="text" data-spec-director-name class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
			</label>
			<label class="block font-sans text-xs uppercase tracking-wider text-muted">
				Регалии
				<input type="text" data-spec-director-regalia class="mt-1 w-full border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent" />
			</label>
		</div>
		<div class="mt-4 border-t-[2px] border-ink pt-4">
			<p class="font-sans text-xs uppercase tracking-wider text-muted">Галерея</p>
			<div data-spec-gallery class="mt-3 flex flex-wrap gap-3"></div>
			<label class="mt-3 inline-block cursor-pointer border-[3px] border-ink bg-surface px-3 py-2 font-sans text-[10px] uppercase tracking-widest text-ink shadow-[var(--shadow-card)] hover:bg-accent hover:text-canvas active-shift">
				+ Кадры
				<input type="file" accept="image/*" multiple data-spec-gallery-upload class="hidden" />
			</label>
		</div>
	</article>
</template>
</Layout>

<script>
	const list = document.getElementById('spectacle-list');
	const addBtn = document.getElementById('spec-add');
	const saveBtn = document.getElementById('spec-save');
	const status = document.getElementById('spec-status');
	const tpl = document.getElementById('spec-row-tpl') as HTMLTemplateElement | null;
	let autosaveTimer: number | null = null;
	let saveRequestId = 0;
	let latestSavedId = 0;

	function newId(): string {
		if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
			return crypto.randomUUID();
		}
		return `spectacle-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
	}

	function refreshIndexes() {
		if (!list) return;
		list.querySelectorAll('[data-spec-row]').forEach((row, i) => {
			const el = row.querySelector('[data-spec-index]');
			if (el) el.textContent = String(i + 1);
		});
	}

	function collectPayload() {
		if (!list) return { spectacles: [] };
		const spectacles = [...list.querySelectorAll<HTMLElement>('[data-spec-row]')].map((row, order) => {
			const gallery = [...row.querySelectorAll<HTMLInputElement>('[data-gal-url]')]
				.map((inp) => inp.value.trim())
				.filter(Boolean);
			return {
				id: row.dataset.specId || newId(),
				title: (row.querySelector('[data-spec-title]') as HTMLInputElement | null)?.value ?? '',
				heroPhoto: (row.querySelector('[data-spec-hero]') as HTMLInputElement | null)?.value ?? '',
				directorName: (row.querySelector('[data-spec-director-name]') as HTMLInputElement | null)?.value ?? '',
				directorRegalia: (row.querySelector('[data-spec-director-regalia]') as HTMLInputElement | null)?.value ?? '',
				directorPhoto: (row.querySelector('[data-spec-director-photo]') as HTMLInputElement | null)?.value ?? '',
				gallery,
				order,
			};
		});
		return { spectacles };
	}

	async function persist(mode: 'manual' | 'auto') {
		if (!status) return false;
		const requestId = ++saveRequestId;
		status.textContent = mode === 'manual' ? 'Сохраняю…' : 'Автосохранение…';
		try {
			const res = await fetch('/api/admin/spectacles', {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ data: collectPayload() }),
			});
			const j = await res.json().catch(() => ({}));
			if (requestId < latestSavedId) return false;
			if (!res.ok) {
				status.textContent = j.error ? JSON.stringify(j.error) : 'Ошибка';
				return false;
			}
			latestSavedId = requestId;
			status.textContent = mode === 'manual' ? 'Сохранено.' : 'Автосохранено.';
			return true;
		} catch {
			status.textContent = 'Ошибка';
			return false;
		}
	}

	function scheduleAutoSave() {
		if (autosaveTimer) window.clearTimeout(autosaveTimer);
		autosaveTimer = window.setTimeout(() => {
			persist('auto');
		}, 700);
	}

	async function uploadFile(file: File): Promise<string | null> {
		const fd = new FormData();
		fd.append('file', file);
		const res = await fetch('/api/admin/upload', { method: 'POST', body: fd });
		const data = await res.json().catch(() => ({}));
		return res.ok && data.url ? String(data.url) : null;
	}

	function setPreview(img: HTMLImageElement | null, hidden: HTMLInputElement | null, url: string) {
		if (hidden) hidden.value = url;
		if (img) {
			img.src = url;
			img.style.display = url ? 'block' : 'none';
		}
	}

	function addGalleryThumb(gallery: HTMLElement, url: string) {
		const wrap = document.createElement('div');
		wrap.className = 'spec-gal relative border-[3px] border-ink bg-muted-surface p-1';
		wrap.setAttribute('data-gal-item', '');
		const hidden = document.createElement('input');
		hidden.type = 'hidden';
		hidden.setAttribute('data-gal-url', '');
		hidden.value = url;
		const img = document.createElement('img');
		img.src = url;
		img.alt = '';
		img.className = 'h-20 w-28 object-cover';
		const rm = document.createElement('button');
		rm.type = 'button';
		rm.setAttribute('data-gal-remove', '');
		rm.className =
			'absolute right-1 top-1 flex h-6 w-6 items-center justify-center border-[2px] border-ink bg-surface text-xs hover:bg-accent hover:text-canvas';
		rm.title = 'Удалить кадр';
		rm.textContent = '✕';
		wrap.append(hidden, img, rm);
		gallery.appendChild(wrap);
	}

	function addRow() {
		if (!list || !tpl) return;
		const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
		if (!node) return;
		node.dataset.specId = newId();
		list.appendChild(node);
		refreshIndexes();
		scheduleAutoSave();
	}

	list?.addEventListener('click', (e) => {
		const t = e.target as HTMLElement | null;
		const row = t?.closest<HTMLElement>('[data-spec-row]');
		if (!row || !list) return;
		if (t?.closest('[data-spec-remove]')) {
			if (!window.confirm('Удалить этот спектакль?')) return;
			row.remove();
			refreshIndexes();
			scheduleAutoSave();
			return;
		}
		if (t?.closest('[data-spec-up]')) {
			row.previousElementSibling?.before(row);
			refreshIndexes();
			scheduleAutoSave();
			return;
		}
		if (t?.closest('[data-spec-down]')) {
			row.nextElementSibling?.after(row);
			refreshIndexes();
			scheduleAutoSave();
			return;
		}
		if (t?.closest('[data-gal-remove]')) {
			t.closest('[data-gal-item]')?.remove();
			scheduleAutoSave();
		}
	});

	list?.addEventListener('input', scheduleAutoSave);

	list?.addEventListener('change', async (e) => {
		const t = e.target as HTMLInputElement | null;
		if (!t || t.type !== 'file') return;
		const row = t.closest<HTMLElement>('[data-spec-row]');
		if (!row) return;
		const files = [...(t.files ?? [])];
		t.value = '';
		if (!files.length) return;
		if (status) status.textContent = 'Загрузка…';
		if (t.matches('[data-spec-hero-upload]')) {
			const url = await uploadFile(files[0]);
			if (url) {
				setPreview(
					row.querySelector('[data-spec-hero-preview]'),
					row.querySelector('[data-spec-hero]'),
					url,
				);
				scheduleAutoSave();
			} else if (status) status.textContent = 'Ошибка загрузки';
			return;
		}
		if (t.matches('[data-spec-director-upload]')) {
			const url = await uploadFile(files[0]);
			if (url) {
				setPreview(
					row.querySelector('[data-spec-director-preview]'),
					row.querySelector('[data-spec-director-photo]'),
					url,
				);
				scheduleAutoSave();
			} else if (status) status.textContent = 'Ошибка загрузки';
			return;
		}
		if (t.matches('[data-spec-gallery-upload]')) {
			const gallery = row.querySelector<HTMLElement>('[data-spec-gallery]');
			if (!gallery) return;
			for (const file of files) {
				const url = await uploadFile(file);
				if (url) addGalleryThumb(gallery, url);
			}
			scheduleAutoSave();
		}
	});

	addBtn?.addEventListener('click', addRow);
	saveBtn?.addEventListener('click', () => persist('manual'));
</script>
