---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import EtudeTopicSheets from '../../components/EtudeTopicSheets.astro';
import { readEtudeTopics, readStudentsSorted } from '../../lib/siteContent';
import { etudesForTopic, pickActiveTopic, sortTopicsNewestLeft, topicHidesEtudeTitle } from '../../lib/etudeTopics';
import { hasValidAdminSession } from '../../lib/adminApiAuth';

if (!hasValidAdminSession(Astro.cookies)) {
	const nextUrl = Astro.url.pathname + Astro.url.search;
	return Astro.redirect(`/admin/login?next=${encodeURIComponent(nextUrl)}`);
}

const students = await readStudentsSorted();
const catalog = await readEtudeTopics();
const topics = sortTopicsNewestLeft(catalog.topics);
const active = pickActiveTopic(topics, Astro.url.searchParams.get('topic'));
const orderBySlug = new Map(students.map((s) => [s.slug, s.data.order]));
const rows = active
	? etudesForTopic(catalog.etudes, active.id).slice().sort((a, b) => {
			const ao = orderBySlug.get(a.participantSlugs[0] ?? '') ?? 9999;
			const bo = orderBySlug.get(b.participantSlugs[0] ?? '') ?? 9999;
			if (ao !== bo) return ao - bo;
			return (a.title || a.id).localeCompare(b.title || b.id, 'ru');
		})
	: [];
const hideTitle = topicHidesEtudeTitle(active);

const initialJson = JSON.stringify({
	topics: catalog.topics,
	etudes: catalog.etudes,
	activeTopicId: active?.id ?? '',
	hideTitle,
	students: students.map((s) => ({ slug: s.slug, displayName: s.data.displayName })),
});
---

<Layout admin title="Класс · редактирование">
	<EtudeTopicSheets
		slot="after-ticker"
		topics={topics}
		activeId={active?.id ?? null}
		basePath="/admin/class"
		newTopicControl
	/>

	<div class="mb-8 flex flex-wrap items-start justify-between gap-4 border-b-[3px] border-ink pb-4">
		<div>
			<h1 class="font-display text-4xl font-normal uppercase tracking-widest text-ink sm:text-5xl">Класс</h1>
			<p class="mt-2 font-sans text-sm uppercase tracking-wider text-muted">
				Темы как листы Excel (новые слева). В теме — этюды с несколькими участниками.
			</p>
		</div>
		{
			active && (
				<div class="flex flex-wrap gap-2">
					<button
						type="button"
						id="rename-topic-btn"
						class="border-[3px] border-ink bg-surface px-4 py-2 font-sans text-sm uppercase tracking-widest text-ink shadow-[var(--shadow-card)] transition-colors hover:bg-accent hover:text-canvas active-shift"
					>
						Переименовать
					</button>
					<button
						type="button"
						id="delete-topic-btn"
						class="border-[3px] border-ink bg-surface px-4 py-2 font-sans text-sm uppercase tracking-widest text-ink shadow-[var(--shadow-card)] transition-colors hover:bg-accent hover:text-canvas active-shift"
					>
						Удалить тему
					</button>
				</div>
			)
		}
	</div>

	{
		!active ? (
			<div class="border-[3px] border-dashed border-ink bg-muted-surface p-8 text-center font-sans text-sm uppercase text-muted">
				Создайте первую тему кнопкой «+ Тема».
			</div>
		) : (
			<>
				<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
					<h2 id="active-topic-title" class="font-display text-2xl uppercase tracking-widest text-ink">{active.title}</h2>
					<button
						type="button"
						id="add-etude-btn"
						class="border-[3px] border-ink bg-surface px-4 py-2 font-sans text-sm uppercase tracking-widest text-ink shadow-[var(--shadow-card)] transition-colors hover:bg-accent hover:text-canvas active-shift"
					>
						<span class="text-xl leading-none">+</span> Этюд
					</button>
				</div>

				<div class="bb-scrollbar max-w-full overflow-x-auto border-[3px] border-ink bg-surface shadow-[var(--shadow-card)]">
					<table
						class="kit-data-table text-left font-sans text-[10px] sm:text-sm"
						id="class-etudes-table"
						data-hide-title={hideTitle ? '1' : '0'}
					>
						<thead>
							<tr class="border-b-[3px] border-ink bg-ink text-canvas">
								<th class:list={[
									'border-r-[2px] border-ink px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base',
									hideTitle ? 'w-[36%]' : 'w-[28%]',
								]}>
									Участники
								</th>
								{
									!hideTitle && (
										<th class="w-[24%] border-r-[2px] border-ink/20 px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base">
											Название этюда
										</th>
									)
								}
								<th class="border-r-[2px] border-ink/20 px-1.5 py-2 font-display text-[10px] font-normal uppercase tracking-wide sm:px-3 sm:py-3.5 sm:text-base">
									Комментарий педагога
								</th>
								<th class="w-8 px-1 py-2 text-center font-display text-[10px] font-normal sm:w-14 sm:text-base"> </th>
							</tr>
						</thead>
						<tbody id="etude-tbody">
							{rows.map((row) => (
								<tr class="etude-row border-b-[2px] border-ink/20 last:border-0 hover:bg-muted-surface" data-etude-id={row.id}>
									<td class="border-r-[2px] border-ink px-1.5 py-2 align-top sm:px-3 sm:py-3">
										<div class="flex flex-col gap-2">
											<div class="flex flex-wrap gap-x-2 gap-y-1" data-selected-names></div>
											<details class="font-sans text-[10px] uppercase tracking-wider text-muted">
												<summary class="cursor-pointer hover:text-accent">Выбрать</summary>
												<div class="mt-2 grid max-h-48 gap-1 overflow-y-auto border-[2px] border-ink bg-muted-surface p-2">
													{students.map((s) => (
														<label class="flex cursor-pointer items-center gap-2 text-[10px] text-ink sm:text-xs">
															<input
																type="checkbox"
																class="et-part h-4 w-4 shrink-0 border-[2px] border-ink accent-accent"
																value={s.slug}
																checked={row.participantSlugs.includes(s.slug)}
															/>
															{s.data.displayName}
														</label>
													))}
												</div>
											</details>
										</div>
									</td>
									{
										!hideTitle && (
											<td class="border-r-[2px] border-ink/20 px-1.5 py-2 align-top sm:px-3 sm:py-3">
												<input
													type="text"
													class="et-title w-full min-w-0 border-[2px] border-ink bg-surface px-2 py-1.5 font-sans text-[10px] uppercase text-ink focus:outline-none focus:ring-2 focus:ring-accent sm:text-sm"
													value={row.title}
												/>
											</td>
										)
									}
									<td class="border-r-[2px] border-ink/20 px-1.5 py-2 align-top sm:px-3 sm:py-3">
										<textarea
											class="et-comment w-full min-w-0 border-[2px] border-ink bg-surface px-2 py-1.5 font-sans text-[10px] leading-relaxed text-ink focus:outline-none focus:ring-2 focus:ring-accent sm:text-sm"
											rows="2"
										>{row.teacherComment ?? ''}</textarea>
									</td>
									<td class="px-1 py-2 text-center align-top">
										<button
											type="button"
											class="remove-etude-btn text-muted hover:text-accent"
											title="Удалить этюд"
										>
											✕
										</button>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</>
		)
	}

	<div class="mt-8 flex flex-wrap items-center gap-4">
		<button
			type="button"
			id="class-save"
			class="border-[3px] border-ink bg-accent px-6 py-3 font-display text-xl tracking-widest text-canvas shadow-[var(--shadow-card)] transition-colors hover:bg-accent-hover active-shift"
		>
			Сохранить класс
		</button>
		<span id="class-status" class="font-sans text-sm uppercase text-muted"></span>
	</div>

	<section class="mt-12 border-t-[3px] border-ink pt-8">
		<h2 class="mb-4 font-display text-2xl uppercase tracking-widest text-ink">Карточки учеников</h2>
		<p class="mb-4 font-sans text-xs uppercase tracking-wider text-muted">
			Профили (фото, ФИО) — отдельно. Этюды на /class берутся из тем выше, не из карточки.
		</p>
		<ul class="grid gap-2 sm:grid-cols-2">
			{
				students.map((s) => (
					<li>
						<a
							href={`/admin/student/${s.slug}`}
							class="flex items-center justify-between border-[3px] border-ink bg-surface px-3 py-2 font-sans text-sm uppercase tracking-wider text-ink shadow-[var(--shadow-card)] transition-colors hover:bg-accent hover:text-canvas"
						>
							<span>{s.data.displayName}</span>
							<span class="font-mono text-[10px] text-muted">{s.slug}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<script id="class-initial" type="application/json" set:html={initialJson} />

	<script>
		type Topic = { id: string; title: string; createdAt: string };
		type Etude = {
			id: string;
			topicId: string;
			title: string;
			teacherComment?: string;
			participantSlugs: string[];
		};
		type StudentOpt = { slug: string; displayName: string };
		type Catalog = {
			topics: Topic[];
			etudes: Etude[];
			activeTopicId: string;
			hideTitle?: boolean;
			students: StudentOpt[];
		};

		const initialEl = document.getElementById('class-initial');
		const status = document.getElementById('class-status');
		const saveBtn = document.getElementById('class-save');
		const addEtudeBtn = document.getElementById('add-etude-btn');
		const addTopicBtn = document.getElementById('etude-topic-new');
		const renameBtn = document.getElementById('rename-topic-btn');
		const deleteBtn = document.getElementById('delete-topic-btn');
		const tbody = document.getElementById('etude-tbody');

		let autosaveTimer: number | null = null;
		let saveRequestId = 0;
		let latestSavedId = 0;

		function readInitial(): Catalog {
			if (!initialEl?.textContent) {
				return { topics: [], etudes: [], activeTopicId: '', hideTitle: false, students: [] };
			}
			return JSON.parse(initialEl.textContent) as Catalog;
		}

		const catalog = readInitial();

		function newId(prefix: string): string {
			return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
		}

		function studentName(slug: string): string {
			return catalog.students.find((s) => s.slug === slug)?.displayName ?? slug;
		}

		function refreshSelectedNames(row: Element) {
			const host = row.querySelector('[data-selected-names]');
			if (!host) return;
			const slugs = Array.from(row.querySelectorAll('.et-part'))
				.filter((el) => (el as HTMLInputElement).checked)
				.map((el) => (el as HTMLInputElement).value);
			host.innerHTML = slugs.length
				? slugs
						.map(
							(slug) =>
								`<span class="uppercase tracking-wider text-ink">${studentName(slug)}</span>`,
						)
						.join('<span class="text-muted">·</span>')
				: '<span class="text-muted">—</span>';
		}

		function refreshAllNames() {
			document.querySelectorAll('.etude-row').forEach((row) => refreshSelectedNames(row));
		}

		function hidesTitle(): boolean {
			const table = document.getElementById('class-etudes-table');
			return table?.getAttribute('data-hide-title') === '1' || Boolean(catalog.hideTitle);
		}

		function collectCurrentTopicEtudes(): Etude[] {
			if (!tbody || !catalog.activeTopicId) return [];
			const out: Etude[] = [];
			const noTitle = hidesTitle();
			tbody.querySelectorAll('.etude-row').forEach((row) => {
				const title = noTitle
					? ''
					: ((row.querySelector('.et-title') as HTMLInputElement | null)?.value?.trim() ?? '');
				const teacherComment =
					(row.querySelector('.et-comment') as HTMLTextAreaElement | null)?.value?.trim() ?? '';
				const participantSlugs = Array.from(row.querySelectorAll('.et-part'))
					.filter((el) => (el as HTMLInputElement).checked)
					.map((el) => (el as HTMLInputElement).value);
				const id = row.getAttribute('data-etude-id') || newId('etude');
				out.push({
					id,
					topicId: catalog.activeTopicId,
					title,
					teacherComment,
					participantSlugs,
				});
			});
			return out;
		}

		function collectPayload(): { topics: Topic[]; etudes: Etude[] } {
			const current = collectCurrentTopicEtudes();
			const others = catalog.etudes.filter((e) => e.topicId !== catalog.activeTopicId);
			return {
				topics: catalog.topics,
				etudes: [...others, ...current],
			};
		}

		async function persist(
			mode: 'manual' | 'auto',
			nextUrl?: string,
			override?: { topics: Topic[]; etudes: Etude[] },
		) {
			if (!status) return false;
			const requestId = ++saveRequestId;
			status.textContent = mode === 'manual' ? 'Сохраняю…' : 'Автосохранение…';
			const payload = override ?? collectPayload();
			catalog.topics = payload.topics;
			catalog.etudes = payload.etudes;
			if (initialEl) initialEl.textContent = JSON.stringify({ ...catalog, ...payload });
			const res = await fetch('/api/admin/etude-topics', {
				method: 'PUT',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ data: payload }),
			});
			const j = await res.json().catch(() => ({}));
			if (requestId < latestSavedId) return false;
			if (!res.ok) {
				status.textContent = j.error ? JSON.stringify(j.error) : 'Ошибка';
				return false;
			}
			latestSavedId = requestId;
			status.textContent = mode === 'manual' ? 'Сохранено.' : 'Автосохранено.';
			if (nextUrl) window.location.assign(nextUrl);
			return true;
		}

		function scheduleAutoSave() {
			if (autosaveTimer) window.clearTimeout(autosaveTimer);
			autosaveTimer = window.setTimeout(() => {
				persist('auto');
			}, 700);
		}

		function participantEditorHtml(selected: string[]): string {
			const boxes = catalog.students
				.map((s) => {
					const checked = selected.includes(s.slug) ? 'checked' : '';
					return `<label class="flex cursor-pointer items-center gap-2 text-[10px] text-ink sm:text-xs"><input type="checkbox" class="et-part h-4 w-4 border-[2px] border-ink accent-accent" value="${s.slug}" ${checked} />${s.displayName}</label>`;
				})
				.join('');
			return `<div class="flex flex-col gap-2"><div class="flex flex-wrap gap-x-2 gap-y-1" data-selected-names></div><details class="font-sans text-[10px] uppercase tracking-wider text-muted"><summary class="cursor-pointer hover:text-accent">Выбрать</summary><div class="mt-2 grid max-h-48 gap-1 overflow-y-auto border-[2px] border-ink bg-muted-surface p-2">${boxes}</div></details></div>`;
		}

		addEtudeBtn?.addEventListener('click', () => {
			if (!tbody || !catalog.activeTopicId) return;
			const tr = document.createElement('tr');
			tr.className = 'etude-row border-b-[2px] border-ink/20 last:border-0 hover:bg-muted-surface';
			tr.setAttribute('data-etude-id', newId('etude'));
			const titleCell = hidesTitle()
				? ''
				: `<td class="border-r-[2px] border-ink/20 px-1.5 py-2 align-top sm:px-3 sm:py-3">
					<input type="text" class="et-title w-full min-w-0 border-[2px] border-ink bg-surface px-2 py-1.5 font-sans text-[10px] uppercase text-ink focus:outline-none focus:ring-2 focus:ring-accent sm:text-sm" value="" />
				</td>`;
			tr.innerHTML = `
				<td class="border-r-[2px] border-ink px-1.5 py-2 align-top sm:px-3 sm:py-3">${participantEditorHtml([])}</td>
				${titleCell}
				<td class="border-r-[2px] border-ink/20 px-1.5 py-2 align-top sm:px-3 sm:py-3">
					<textarea class="et-comment w-full min-w-0 border-[2px] border-ink bg-surface px-2 py-1.5 font-sans text-[10px] leading-relaxed text-ink focus:outline-none focus:ring-2 focus:ring-accent sm:text-sm" rows="2"></textarea>
				</td>
				<td class="px-1 py-2 text-center align-top">
					<button type="button" class="remove-etude-btn text-muted hover:text-accent" title="Удалить этюд">✕</button>
				</td>
			`;
			tbody.appendChild(tr);
			refreshSelectedNames(tr);
			scheduleAutoSave();
		});

		tbody?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement | null;
			const removeBtn = target?.closest('.remove-etude-btn');
			if (!removeBtn) return;
			removeBtn.closest('.etude-row')?.remove();
			scheduleAutoSave();
		});

		tbody?.addEventListener('input', () => scheduleAutoSave());
		tbody?.addEventListener('change', (e) => {
			const t = e.target as HTMLElement | null;
			const row = t?.closest('.etude-row');
			if (row) refreshSelectedNames(row);
			scheduleAutoSave();
		});

		addTopicBtn?.addEventListener('click', async () => {
			const title = window.prompt('Название новой темы:', '');
			if (!title || !title.trim()) return;
			const topic: Topic = {
				id: newId('topic'),
				title: title.trim(),
				createdAt: new Date().toISOString(),
			};
			catalog.topics = [topic, ...catalog.topics];
			await persist('manual', `/admin/class?topic=${encodeURIComponent(topic.id)}`);
		});

		renameBtn?.addEventListener('click', () => {
			if (!catalog.activeTopicId) return;
			const current = catalog.topics.find((t) => t.id === catalog.activeTopicId);
			const next = window.prompt('Новое название темы:', current?.title ?? '');
			if (next === null || !next.trim()) return;
			catalog.topics = catalog.topics.map((t) =>
				t.id === catalog.activeTopicId ? { ...t, title: next.trim() } : t,
			);
			const tab = document.querySelector(`[data-topic-id="${catalog.activeTopicId}"]`);
			if (tab) tab.textContent = next.trim();
			const heading = document.getElementById('active-topic-title');
			if (heading) heading.textContent = next.trim();
			scheduleAutoSave();
		});

		deleteBtn?.addEventListener('click', async () => {
			if (!catalog.activeTopicId) return;
			const removedId = catalog.activeTopicId;
			const current = catalog.topics.find((t) => t.id === removedId);
			if (!window.confirm(`Удалить тему «${current?.title ?? ''}» и все её этюды?`)) return;
			const snapshot = collectPayload();
			const topics = snapshot.topics.filter((t) => t.id !== removedId);
			const etudes = snapshot.etudes.filter((e) => e.topicId !== removedId);
			const leftover = [...topics].sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))[0];
			catalog.activeTopicId = leftover?.id ?? '';
			const nextUrl = leftover ? `/admin/class?topic=${encodeURIComponent(leftover.id)}` : '/admin/class';
			await persist('manual', nextUrl, { topics, etudes });
		});

		saveBtn?.addEventListener('click', async () => {
			await persist('manual');
		});

		refreshAllNames();
	</script>
</Layout>
