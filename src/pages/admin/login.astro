---
export const prerender = false;
import '../../styles/global.css';
import { cookieName, getSessionSecret, verifySessionToken } from '../../lib/auth';

const secret = getSessionSecret();
const token = Astro.cookies.get(cookieName())?.value;
if (secret && token && verifySessionToken(token, secret)) {
	return Astro.redirect('/admin');
}

const next = Astro.url.searchParams.get('next') ?? '/admin';
---

<!doctype html>
<html lang="ru" data-theme="classic">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<script is:inline>
			try {
				var k = 'kit20-theme';
				var v = localStorage.getItem(k);
				if (v === 'brutal' || v === 'poetry' || v === 'swiss' || v === 'classic') {
					document.documentElement.setAttribute('data-theme', v);
				}
			} catch (e) {}
		</script>
		<meta name="theme-color" content="#100d0c" />
		<title>Вход · КиТ20</title>
	</head>
	<body class="relative overflow-x-hidden bg-stage font-sans text-canvas antialiased">
		<div
			class="pointer-events-none absolute inset-x-0 top-0 h-[46px]"
			style="background:radial-gradient(circle at 50% 0, #8f1016 0 70%, transparent 71%) 0 0/64px 46px repeat-x, linear-gradient(#5e0a0e,#5e0a0e) 0 0/100% 18px no-repeat;filter:drop-shadow(0 8px 10px rgba(0,0,0,.5))"
			aria-hidden="true"
		></div>
		<div
			class="relative z-10 flex min-h-dvh flex-col items-center justify-center px-4 py-16"
			style="background:radial-gradient(ellipse 70% 55% at 50% 105%, rgba(255,90,85,.13), transparent 70%)"
		>
			<a href="/" class="mb-8 font-display text-[64px] font-black leading-none text-canvas no-underline">КиТ<span class="text-[#ff5a55]">20</span></a>
			<div class="w-full max-w-md rounded-md bg-canvas p-8 text-ink shadow-[var(--shadow-float)]">
				<p class="font-mono text-[12px] uppercase tracking-[0.14em] text-muted">Служебный вход · <b class="font-semibold text-accent">администратор</b></p>
				<h1 class="mt-2 font-display text-5xl font-black uppercase leading-[0.9] text-ink">Вход для редактирования</h1>
				<form class="mt-6 space-y-4" method="POST" action="/api/admin/login">
					<input type="hidden" name="next" value={next} />
					<label class="block font-mono text-[12px] uppercase tracking-[0.12em] text-muted">
						Пароль
						<input
							type="password"
							name="password"
							required
							autocomplete="current-password"
							class="mt-1.5 w-full rounded-md border-[1.5px] border-ink bg-surface px-4 py-3 font-sans text-base normal-case tracking-normal text-ink outline-none focus:ring-4 focus:ring-[#ff5a55]/30"
						/>
					</label>
					<button
						type="submit"
						class="w-full rounded-full bg-accent px-4 py-3.5 font-sans text-base font-semibold text-white transition-colors hover:bg-accent-hover"
					>
						Войти
					</button>
				</form>
				<p class="mt-6 text-center text-sm">
					<a href="/" class="font-mono text-[12px] uppercase tracking-[0.1em] text-accent hover:text-accent-hover">← На сайт</a>
				</p>
			</div>
		</div>
	</body>
</html>
